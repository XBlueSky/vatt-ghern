---
permalink: /search-index.json
eleventyExcludeFromCollections: true
---
{
  "generated_at": "{{ '' | dateISO }}",
  "site": {
    "url": "{{ site.url }}",
    "name": "{{ site.name }}"
  },
  "posts": [
{%- set first = true -%}
{%- for post in collections.posts -%}
{%- if not first %},{% endif -%}
{%- set first = false -%}
    {
      "url": "{{ post.url }}",
      "date": "{{ post.date | dateYMD }}",
      "title": {{ post.data.title | dump | safe }},
      "summary": {{ (post.data.summary or "") | dump | safe }},
      "archetype": {{ (post.data.archetype or "") | dump | safe }},
      "deep_archetype": {{ (post.data.deep_archetype or "") | dump | safe }},
      "tags": {{ (post.data.tags or []) | dump | safe }},
      "topics": {{ (post.data.topics or []) | dump | safe }}
    }
{%- endfor %}
  ]
}
