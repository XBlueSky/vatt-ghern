---
layout: layouts/base.njk
title: 歷史
permalink: /archive/
---
<section class="vg-archive">
  <header class="vg-archive-hero">
    <h1 class="vg-archive-title">歷史</h1>
    <p class="vg-archive-lede">所有 daily news，依日期排序。</p>
  </header>
  <ol class="vg-archive-timeline">
    {% for day in collections.daysWithPosts %}
      <li class="vg-archive-day">
        <span class="vg-archive-marker">{{ day.date | dateMD }}</span>
        <div class="vg-archive-posts">
          {% for p in day.posts %}
            <a href="{{ p.url }}" data-vg-readkey="{{ p.url }}">{{ p.data.title }}</a>
          {% endfor %}
        </div>
      </li>
    {% endfor %}
  </ol>
  <footer class="vg-archive-foot">
    累積 {{ collections.daysWithPosts.length }} 天 · {{ collections.posts.length }} 篇
  </footer>
</section>
