---
layout: layouts/base.njk
title: archive
permalink: /archive/
---
{% set months = collections.daysWithPosts | groupByMonth %}
<section class="vg-archive">
  <header class="vg-archive-hero">
    <h1 class="vg-archive-title">archive</h1>
    <p class="vg-archive-lede">All daily news, by month.</p>
    <p class="vg-archive-stats">
      <strong>{{ collections.daysWithPosts.length }}</strong> {% if collections.daysWithPosts.length == 1 %}day{% else %}days{% endif %}
      <span class="vg-sep" aria-hidden="true">·</span>
      <strong>{{ collections.posts.length }}</strong> {% if collections.posts.length == 1 %}post{% else %}posts{% endif %}
      {% if months.length > 0 %}
        <span class="vg-sep" aria-hidden="true">·</span>
        <strong>{{ months.length }}</strong> {% if months.length == 1 %}month{% else %}months{% endif %}
      {% endif %}
    </p>
  </header>

  {% if months.length > 0 %}
  <nav class="vg-archive-monthbar" aria-label="Month navigation" data-vg-monthbar>
    {% for m in months %}
      <a class="vg-archive-monthbar-link"
         href="#m-{{ m.monthKey }}"
         data-vg-month="{{ m.monthKey }}">{{ m.monthLabel }}</a>
      {% if not loop.last %}<span class="vg-archive-monthbar-sep" aria-hidden="true">·</span>{% endif %}
    {% endfor %}
  </nav>

  {% for m in months %}
    <section class="vg-archive-month" id="m-{{ m.monthKey }}" data-vg-month-section="{{ m.monthKey }}">
      <header class="vg-archive-month-header">
        <a class="vg-archive-month-prev"
           {% if not loop.last %}href="#m-{{ months[loop.index].monthKey }}"
           aria-label="previous month"{% else %}aria-disabled="true" tabindex="-1"{% endif %}>
          {% lucide "chevron-left" %}
        </a>
        <h2 class="vg-archive-month-title">{{ m.monthLabel }}</h2>
        <a class="vg-archive-month-next"
           {% if loop.index0 > 0 %}href="#m-{{ months[loop.index0 - 1].monthKey }}"
           aria-label="next month"{% else %}aria-disabled="true" tabindex="-1"{% endif %}>
          {% lucide "chevron-right" %}
        </a>
        <span class="vg-archive-month-stats">
          {{ m.dayCount }} {% if m.dayCount == 1 %}day{% else %}days{% endif %}
          <span class="vg-sep" aria-hidden="true">·</span>
          {{ m.postCount }} {% if m.postCount == 1 %}post{% else %}posts{% endif %}
        </span>
      </header>

      <div class="vg-archive-month-grid" role="grid" aria-label="{{ m.monthLabel }} calendar">
        <div class="vg-archive-cal-row vg-archive-cal-head" role="row">
          {% for d in ["S","M","T","W","T","F","S"] %}
            <span class="vg-archive-cal-day-label" role="columnheader">{{ d }}</span>
          {% endfor %}
        </div>
        {% for row in m.rows %}
          <div class="vg-archive-cal-row" role="row">
            {% for cell in row %}
              {% if cell.day == null %}
                <span class="vg-archive-cal-cell vg-archive-cal-cell-blank" role="gridcell" aria-hidden="true"></span>
              {% elif cell.hasPosts %}
                <a class="vg-archive-cal-cell vg-archive-cal-cell-active"
                   href="#m-{{ m.monthKey }}-{{ cell.anchor }}"
                   role="gridcell"
                   aria-label="{{ cell.iso }} — {{ cell.postsCount }} post{% if cell.postsCount != 1 %}s{% endif %}">
                  <span class="vg-archive-cal-num">{{ cell.day }}</span>
                  <span class="vg-archive-cal-dot" aria-hidden="true"></span>
                </a>
              {% else %}
                <span class="vg-archive-cal-cell vg-archive-cal-cell-empty" role="gridcell">
                  <span class="vg-archive-cal-num">{{ cell.day }}</span>
                </span>
              {% endif %}
            {% endfor %}
          </div>
        {% endfor %}
      </div>

      {% for week in m.weeks %}
        <section class="vg-archive-week" aria-label="{{ m.monthLabel }} · {{ week.weekLabel }}">
          <h3 class="vg-archive-week-label">{{ week.weekLabel }}</h3>
          <ol class="vg-archive-day-list">
            {% for day in week.days %}
              {% set roundupPost = null %}
              {% set deepPosts = [] %}
              {% for p in day.posts %}
                {% if p.data.archetype == "daily-roundup" %}
                  {% set roundupPost = p %}
                {% else %}
                  {% set deepPosts = (deepPosts.push(p), deepPosts) %}
                {% endif %}
              {% endfor %}
              <li class="vg-archive-day"
                  id="m-{{ m.monthKey }}-d-{{ day.date | dayNum }}"
                  data-vg-readkey="{% if roundupPost %}{{ roundupPost.url }}{% endif %}">
                <span class="vg-archive-day-date">{{ day.date | dateMD }}</span>
                <div class="vg-archive-day-body">
                  {% if roundupPost %}
                    <a class="vg-archive-day-title"
                       href="{{ roundupPost.url }}"
                       data-vg-readkey="{{ roundupPost.url }}">{{ roundupPost.data.title }}</a>
                  {% endif %}
                  {% if deepPosts.length > 0 %}
                    <ul class="vg-archive-day-deeps">
                      {% for d in deepPosts %}
                        <li>
                          <a href="{{ d.url }}" data-vg-readkey="{{ d.url }}">{{ d.data.title }}</a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>
              </li>
            {% endfor %}
          </ol>
        </section>
      {% endfor %}
    </section>
  {% endfor %}
  {% else %}
    <p class="vg-archive-empty">No posts yet.</p>
  {% endif %}
</section>

<script>
  // Sticky monthbar — highlight the month-link whose section is currently in
  // view. Pure IntersectionObserver, no framework. Falls back to first-link
  // active if IO not supported.
  (function () {
    var bar = document.querySelector("[data-vg-monthbar]");
    if (!bar) return;
    var links = Array.from(bar.querySelectorAll(".vg-archive-monthbar-link"));
    var sections = Array.from(document.querySelectorAll("[data-vg-month-section]"));
    if (!links.length || !sections.length) return;

    function setActive(key) {
      links.forEach(function (l) {
        l.classList.toggle("vg-archive-monthbar-link-active", l.dataset.vgMonth === key);
      });
    }
    if (!("IntersectionObserver" in window)) {
      setActive(links[0].dataset.vgMonth);
      return;
    }
    var visibility = new Map();
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        visibility.set(e.target.dataset.vgMonthSection, e.intersectionRatio);
      });
      var best = null;
      var bestRatio = 0;
      visibility.forEach(function (ratio, key) {
        if (ratio > bestRatio) { bestRatio = ratio; best = key; }
      });
      if (best) setActive(best);
    }, {
      // Trigger when section top crosses ~25% from viewport top, so the
      // currently-reading month bar follows scroll naturally.
      rootMargin: "-25% 0px -60% 0px",
      threshold: [0, 0.2, 0.5, 0.8, 1],
    });
    sections.forEach(function (s) { io.observe(s); });
    setActive(sections[0].dataset.vgMonthSection);
  })();
</script>
