# Cloudflare Pages security headers.
# Format: https://developers.cloudflare.com/pages/configuration/headers/
#
# Static site, no auth, no cookies, no XHR — the threat model is mostly
# (a) content-injection if a sub-agent or upstream source HTML escapes
# our build pipeline, (b) clickjacking on social shares, (c) MIME
# sniffing, (d) third-party tracking the browser would silently honour
# (FLoC / Topics).

/*
  # ── CSP ─────────────────────────────────────────────────────────────
  # 'unsafe-inline' on script-src and style-src is required because the
  # daily-news skill emits per-figure inline <style> + <script> blocks
  # (see widget-isolation.md). Moving to nonce-based CSP would require
  # build-time nonce injection per widget — substantial refactor; the
  # tradeoff is documented in docs/.
  #
  # `img-src https: data:` allows social og images, inline SVG data URIs
  # in the lucide affordance icons, and any external image in author
  # content (we don't currently use any but the cost is low).
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; media-src 'self'

  # ── Anti-clickjacking ───────────────────────────────────────────────
  X-Frame-Options: DENY

  # ── MIME sniffing ───────────────────────────────────────────────────
  X-Content-Type-Options: nosniff

  # ── Referrer policy ─────────────────────────────────────────────────
  # Send origin (not full path) on cross-origin requests; full URL on
  # same-origin. Stops "deep" URL leaking via Referer to third parties.
  Referrer-Policy: strict-origin-when-cross-origin

  # ── Opt out of browser-level tracking surfaces ──────────────────────
  # interest-cohort (FLoC, retired), browsing-topics (Topics API).
  # No need to advertise our visitors to ad networks.
  Permissions-Policy: interest-cohort=(), browsing-topics=(), camera=(), microphone=(), geolocation=(), payment=()

  # ── HSTS ────────────────────────────────────────────────────────────
  # Cloudflare Pages already serves HTTPS only and redirects HTTP.
  # 1 year, include subdomains. Drop `preload` until we're sure all
  # subdomains are HTTPS — pages.dev preview URLs are fine, but if we
  # later mount a custom domain with a quirky subdomain we'd be locked
  # in.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # ── Cross-origin isolation (defensive) ──────────────────────────────
  # We don't use SharedArrayBuffer / cross-origin embedders, but these
  # headers also help by making sure third-party iframes can't poke us.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Long-cache for fingerprintable static assets. Cloudflare Pages caches
# /static/* heavily by default, so this is mostly belt-and-braces.
#
# Cloudflare _headers MERGES all matching rules, so static assets would
# otherwise inherit the HTML security headers from /* above. Two problems:
#  1. Cross-Origin-Resource-Policy: same-origin blocks Facebook/Slack/
#     LinkedIn/etc. from fetching our og: images cross-origin — the whole
#     point of an og image. Override it to cross-origin here.
#  2. CSP, X-Frame-Options, COOP, Referrer-Policy, Permissions-Policy are
#     document-level directives; meaningless (and noise to OG validators)
#     on a PNG/woff2. Detach them with `! ` (Cloudflare's unset syntax).
# X-Content-Type-Options: nosniff is kept — still correct for assets.
/static/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: cross-origin
  ! Content-Security-Policy
  ! X-Frame-Options
  ! Cross-Origin-Opener-Policy
  ! Referrer-Policy
  ! Permissions-Policy

# Don't let preview deployments get indexed by search engines.
# (The marketing preview URLs are *.pages.dev; the production custom
# domain serves real content and shouldn't carry this header. Cloudflare
# Pages only applies _headers to deployments that build the file, so the
# noindex below applies broadly — adjust to a path glob if we ever want
# production indexed and preview not.)
#
# Commented out by default since the apex production site needs to be
# indexed. Uncomment + scope when we set up a preview-only branch.
# /*
#   X-Robots-Tag: noindex
