---
layout: layouts/base.njk
title: vatt'ghern
permalink: /
---
{% set days = collections.daysWithPosts %}
{% if days.length > 0 %}
  {% set today = days[0] %}
  {% set past = days.slice(1) %}

  <section class="vg-today-hero">
    <div class="vg-today-frame">
      <aside class="vg-today-marker">
        <span class="vg-today-marker-date">{{ today.date | dateMD }}</span>
        <span class="vg-today-marker-tag">今日</span>
      </aside>
      <div class="vg-today-body">
        {% set roundupPost = null %}
        {% set deepPosts = [] %}
        {% for post in today.posts %}
          {% if post.data.archetype == "daily-roundup" %}
            {% set roundupPost = post %}
          {% else %}
            {% set deepPosts = (deepPosts.push(post), deepPosts) %}
          {% endif %}
        {% endfor %}
        {% if roundupPost %}
          <h1 class="vg-today-title">
            <a href="{{ roundupPost.url }}" data-vg-readkey="{{ roundupPost.url }}">{{ roundupPost.data.title }}</a>
          </h1>
          <p class="vg-today-lede">{{ roundupPost.data.summary }}</p>
          <p class="vg-today-meta">
            <span class="vg-today-progress"
                  data-vg-progress-of="{{ roundupPost.url }}#item-"
                  data-vg-progress-total="{{ roundupPost.data.news_ids.length }}">0 / {{ roundupPost.data.news_ids.length }} 已閱</span>
            <span class="vg-today-sep" aria-hidden="true">·</span>
            <a href="{{ roundupPost.url }}">讀 roundup →</a>
          </p>
        {% endif %}
        {% if deepPosts.length > 0 %}
          <section class="vg-today-deep" aria-label="今日深入閱讀">
            <h2 class="vg-today-deep-label">今日深入</h2>
            <ul class="vg-today-deep-list">
              {% for d in deepPosts %}
                <li>
                  <a href="{{ d.url }}" data-vg-readkey="{{ d.url }}">
                    <span class="vg-today-deep-title">{{ d.data.title }}</span>
                    <span class="vg-today-deep-lede">{{ d.data.summary }}</span>
                  </a>
                </li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}
      </div>
    </div>
  </section>

  {% if past.length > 0 %}
    {% set weeks = past | groupByWeek %}
    {% for week in weeks %}
      <section class="vg-week-section">
        <h2 class="vg-week-label">{{ week.weekLabel }}</h2>
        {% for day in week.days %}
          <div class="vg-day-row">
            <span class="vg-day-date">{{ day.date | dateMD }}</span>
            <div class="vg-day-posts">
              {% for p in day.posts %}
                <a href="{{ p.url }}" data-vg-readkey="{{ p.url }}">{{ p.data.title }}</a>
                {% if not loop.last %} · {% endif %}
              {% endfor %}
            </div>
          </div>
        {% endfor %}
      </section>
    {% endfor %}
  {% endif %}
{% else %}
  <section class="vg-empty">
    <p>還沒有任何 daily news。</p>
  </section>
{% endif %}
