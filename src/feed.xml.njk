---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.name }}</title>
  <subtitle>{{ site.subtitle }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{% if collections.posts[0] %}{{ collections.posts[0].data.date | dateISO }}{% else %}{{ now | dateISO }}{% endif %}</updated>
  <id>{{ site.url }}/</id>
  {% for post in collections.posts | take(20) %}
    <entry>
      <title>{{ post.data.title }}</title>
      <link href="{{ site.url }}{{ post.url }}"/>
      <updated>{{ post.data.date | dateISO }}</updated>
      <id>{{ site.url }}{{ post.url }}</id>
      <summary>{{ post.data.summary }}</summary>
    </entry>
  {% endfor %}
</feed>
