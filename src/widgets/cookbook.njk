---
pagination:
  data: widgets.cookbookEntries
  size: 1
  alias: entry
permalink: "/widgets/cookbook/{{ entry.id }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ entry.title }} · cookbook {{ 'hero' if entry.tier == 1 else 'snippet' }}"
eleventyExcludeFromCollections: true
---
<style>
  .vg-w-cb {
    max-width: min(1080px, 100% - 2 * var(--gutter));
    margin: 0 auto;
    padding: var(--s-5) 0 var(--s-6);
    font-family: var(--serif);
    color: var(--ink);
    line-height: 1.78;
  }
  .vg-main:has(.vg-w-cb) { width: var(--col-wide); }

  .vg-w-cb-trail {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--s-3);
  }
  .vg-w-cb-trail a {
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms;
  }
  .vg-w-cb-trail a:hover { border-bottom-color: var(--accent); }
  .vg-w-cb-trail .vg-w-cb-sep { margin: 0 0.5em; color: var(--muted-2); }

  .vg-w-cb-kind {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--s-2);
  }
  .vg-w-cb h1 {
    font-family: var(--display);
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-xl);
    color: var(--ink);
    margin: 0 0 var(--s-3);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .vg-w-cb .vg-w-cb-lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--ink-soft);
    margin: 0 0 var(--s-4);
    max-width: 60ch;
    line-height: 1.55;
  }

  /* Live demo section — common shell + heading */
  .vg-w-cb-live {
    margin: var(--s-4) 0 var(--s-5);
  }
  .vg-w-cb-live h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-lg);
    color: var(--ink);
    margin: 0 0 var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line);
  }
  .vg-w-cb-live:empty,
  .vg-w-cb-live:has(> h2:only-child) {
    display: none;
  }

  /* Recipe disclosure — the .md reference doc body is paste-and-modify
     material for authors; collapse it behind <details> so the public page
     leads with the live demo rather than a 6000px wall of source. */
  .vg-w-cb-recipe {
    margin-top: var(--s-4);
    border-top: 1px solid var(--line);
    padding-top: var(--s-3);
  }
  .vg-w-cb-recipe > summary {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: var(--s-2) 0;
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--accent-text);
  }
  .vg-w-cb-recipe > summary::-webkit-details-marker { display: none; }
  .vg-w-cb-recipe > summary:hover { color: var(--accent-hover); }
  .vg-w-cb-recipe > summary:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .vg-w-cb-recipe-chevron {
    flex-shrink: 0;
    display: block;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vg-w-cb-recipe[open] .vg-w-cb-recipe-chevron {
    transform: rotate(90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .vg-w-cb-recipe-chevron { transition: none; }
  }
  .vg-w-cb-recipe[open] .vg-w-cb-body {
    margin-top: var(--s-3);
  }

  /* Body — markdown-rendered content from cookbook .md file */
  .vg-w-cb-body {
    max-width: 72ch;
    font-size: var(--fs-base);
  }
  .vg-w-cb-body h2,
  .vg-w-cb-body h3 {
    font-family: var(--serif);
    font-weight: 500;
    color: var(--ink);
    line-height: 1.3;
  }
  .vg-w-cb-body h2 {
    font-size: var(--fs-lg);
    margin: var(--s-5) 0 var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line);
  }
  .vg-w-cb-body h3 {
    font-size: var(--fs-md);
    margin: var(--s-4) 0 var(--s-2);
  }
  .vg-w-cb-body p { margin: 0 0 var(--s-3); }
  .vg-w-cb-body blockquote {
    margin: var(--s-3) 0;
    padding: var(--s-2) var(--s-3);
    border-left: 1px solid var(--line);
    font-style: italic;
    color: var(--ink-soft);
  }
  .vg-w-cb-body ul,
  .vg-w-cb-body ol {
    margin: 0 0 var(--s-3);
    padding-left: var(--s-4);
  }
  .vg-w-cb-body li { margin-bottom: 0.3em; }
  .vg-w-cb-body code {
    font-family: var(--mono);
    font-size: 0.88em;
    background: var(--bg-soft);
    padding: 0.05em 0.32em;
    border-radius: 3px;
    color: var(--ink);
  }
  .vg-w-cb-body pre {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--bg-soft);
    color: var(--ink);
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow-x: auto;
    line-height: 1.55;
    margin: var(--s-2) 0 var(--s-3);
  }
  .vg-w-cb-body pre code {
    background: transparent;
    padding: 0;
    color: inherit;
    font: inherit;
  }
  .vg-w-cb-body table {
    width: 100%;
    border-collapse: collapse;
    margin: var(--s-3) 0;
    font-size: var(--fs-sm);
  }
  .vg-w-cb-body th,
  .vg-w-cb-body td {
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .vg-w-cb-body th {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }
  .vg-w-cb-body a {
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
  }
  .vg-w-cb-body a:hover { border-bottom-color: var(--accent); }
</style>

<article class="vg-w-cb">

  <nav class="vg-w-cb-trail" aria-label="Breadcrumb">
    <a href="/widgets/">widgets</a>
    <span class="vg-w-cb-sep">·</span>
    cookbook
    <span class="vg-w-cb-sep">·</span>
    tier {{ entry.tier }}
  </nav>

  <p class="vg-w-cb-kind">{{ entry.kindLabel }}</p>
  <h1>{{ entry.title }}</h1>
  <p class="vg-w-cb-lede">{{ entry.summary }}</p>

  {# Live demo partial. Optional — only the patterns we've authored a demo
     for will resolve. The rest fall through silently and show docs only. #}
  {% set demoPartial = "widget-demos/" + entry.id + ".njk" %}
  <section class="vg-w-cb-live" aria-label="live example">
    <h2>Live example</h2>
    {% include demoPartial ignore missing %}
  </section>

  <details class="vg-w-cb-recipe">
    <summary>
      <svg class="vg-w-cb-recipe-chevron" viewBox="0 0 24 24"
           width="13" height="13" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
           aria-hidden="true">
        <path d="m9 18 6-6-6-6"/>
      </svg>
      <span>完整食譜 (HTML + JS · 複製改寫用)</span>
    </summary>
    <div class="vg-w-cb-body">
      {{ entry.body | md | safe }}
    </div>
  </details>

</article>
