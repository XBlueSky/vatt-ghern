---
pagination:
  data: widgets.catalogEntries
  size: 1
  alias: cw
permalink: "/widgets/catalog/{{ cw.id }}/"
layout: layouts/base.njk
eleventyComputed:
  title: "{{ cw.title }} · catalog widget"
eleventyExcludeFromCollections: true
---
<style>
  .vg-w-cat {
    max-width: min(1080px, 100% - 2 * var(--gutter));
    margin: 0 auto;
    padding: var(--s-5) 0 var(--s-6);
    font-family: var(--serif);
    color: var(--ink);
    line-height: 1.78;
  }
  .vg-main:has(.vg-w-cat) { width: var(--col-wide); }

  .vg-w-cat-trail {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 var(--s-3);
  }
  .vg-w-cat-trail a {
    color: var(--accent-text);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 200ms;
  }
  .vg-w-cat-trail a:hover { border-bottom-color: var(--accent); }
  .vg-w-cat-trail .vg-w-cat-sep { margin: 0 0.5em; color: var(--muted-2); }

  .vg-w-cat-kind {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin: 0 0 var(--s-2);
  }
  .vg-w-cat h1 {
    font-family: var(--display);
    font-style: italic;
    font-weight: 500;
    font-size: var(--fs-xl);
    color: var(--ink);
    margin: 0 0 var(--s-3);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .vg-w-cat .vg-w-cat-lede {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--ink-soft);
    margin: 0 0 var(--s-4);
    max-width: 60ch;
    line-height: 1.55;
  }

  .vg-w-cat-meta {
    display: grid;
    grid-template-columns: max-content 1fr;
    column-gap: var(--s-3);
    row-gap: var(--s-2);
    margin: 0 0 var(--s-4);
    padding: var(--s-3) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .vg-w-cat-meta dt {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
  }
  .vg-w-cat-meta dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: var(--fs-sm);
    line-height: 1.55;
  }
  .vg-w-cat-meta code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--bg-soft);
    padding: 0.05em 0.32em;
    border-radius: 3px;
    color: var(--ink);
  }
  .vg-w-cat-suits {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0.2em 0.8em;
    font-family: var(--scribed); font-style: italic;
    color: var(--accent-text);
  }
  .vg-w-cat-suits li::before { content: "#"; color: var(--muted); margin-right: 0.05em; }
  .vg-w-cat-idioms {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 0.3em 0.6em;
  }
  .vg-w-cat-idioms code { font-size: 0.85em; }

  .vg-w-cat h2 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: var(--fs-lg);
    color: var(--ink);
    margin: var(--s-5) 0 var(--s-3);
    padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--line);
  }

  .vg-w-cat-usage pre {
    font-family: var(--mono);
    font-size: 0.82em;
    background: var(--bg-soft);
    color: var(--ink);
    padding: var(--s-3);
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow-x: auto;
    margin: 0;
  }

  .vg-w-cat-instance {
    margin: var(--s-3) 0 var(--s-4);
    padding: var(--s-4);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
</style>

<article class="vg-w-cat">

  <nav class="vg-w-cat-trail" aria-label="Breadcrumb">
    <a href="/widgets/">widgets</a>
    <span class="vg-w-cat-sep">·</span>
    catalog
  </nav>

  <p class="vg-w-cat-kind">Catalog · {% raw %}{% widget %}{% endraw %} shortcode</p>
  <h1>{{ cw.title }}</h1>
  <p class="vg-w-cat-lede">{{ cw.summary }}</p>

  <dl class="vg-w-cat-meta">
    <dt>id</dt>
    <dd><code>{{ cw.id }}</code></dd>

    {% if cw.suits.length %}
      <dt>suits</dt>
      <dd>
        <ul class="vg-w-cat-suits">
          {% for s in cw.suits %}<li>{{ s }}</li>{% endfor %}
        </ul>
      </dd>
    {% endif %}

    {% if cw.interactive %}
      <dt>state</dt>
      <dd>interactive · {{ cw.instanceState }}</dd>
    {% endif %}

    {% if cw.keyIdioms.length %}
      <dt>idioms</dt>
      <dd>
        <ul class="vg-w-cat-idioms">
          {% for k in cw.keyIdioms %}<li><code>{{ k }}</code></li>{% endfor %}
        </ul>
      </dd>
    {% endif %}
  </dl>

  <h2>Usage</h2>
  <div class="vg-w-cat-usage">
    <pre><code>{% raw %}{% widget "{% endraw %}{{ cw.id }}{% raw %}" %}{% endraw %}</code></pre>
  </div>

  <h2>Live instance</h2>
  <div class="vg-w-cat-instance">
    {% widget cw.id %}
  </div>

</article>
