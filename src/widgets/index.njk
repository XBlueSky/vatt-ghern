<style>
  .vg-w-gallery { max-width: var(--col-wide); margin: 0 auto; padding: var(--s-5) 0 var(--s-6); }
  .vg-w-gallery-head h1 { font-family: var(--display); font-style: italic; font-weight: 500; font-size: var(--fs-xl); color: var(--ink); margin: 0 0 var(--s-2); }
  .vg-w-gallery-lede { font-family: var(--serif); font-style: italic; font-size: var(--fs-md); color: var(--ink-soft); max-width: 62ch; margin: 0 0 var(--s-5); line-height: 1.55; }
  .vg-w-gallery-cat { margin: 0 0 var(--s-5); }
  .vg-w-gallery-cat-head { display: flex; align-items: baseline; gap: var(--s-2); margin: 0 0 var(--s-3); padding-bottom: var(--s-2); border-bottom: 1px solid var(--line); }
  .vg-w-gallery-cat-head h2 { font-family: var(--serif); font-weight: 500; font-size: var(--fs-lg); color: var(--ink); margin: 0; }
  .vg-w-gallery-cat-sub { font-family: var(--sans); font-size: var(--fs-xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .vg-w-gallery-cat-count { margin-left: auto; font-family: var(--mono); font-size: var(--fs-xs); color: var(--muted); }
  .vg-w-gallery-grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); gap: var(--s-3); }
  .vg-w-gallery-card a { display: block; padding: var(--s-3); border: 1px solid var(--line); border-radius: 6px; background: var(--bg-soft); text-decoration: none; transition: border-color 200ms; }
  .vg-w-gallery-card a:hover { border-color: var(--accent); }
  .vg-w-gallery-card h3 { font-family: var(--serif); font-weight: 500; font-size: var(--fs-md); color: var(--ink); margin: 0 0 var(--s-2); }
  .vg-w-gallery-card p { font-family: var(--serif); font-style: italic; font-size: var(--fs-sm); color: var(--ink-soft); margin: 0; line-height: 1.5; }
  /* structural thumbnail — shows what the pattern looks like, not a generic tile */
  .vg-w-gallery-thumb { aspect-ratio: 16/9; background: var(--bg); border: 1px solid var(--line); display: flex; align-items: center; justify-content: center; margin-bottom: var(--s-3); padding: var(--s-2); }
  .vg-w-gallery-sil { width: 100%; height: 100%; color: var(--muted); fill: none; stroke: currentColor; stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; transition: color 160ms ease; }
  .vg-w-gallery-sil .vg-sil-accent { color: var(--accent-text); stroke: currentColor; }
  .vg-w-gallery-sil .vg-sil-accent-fill { fill: var(--accent-shadow); stroke: var(--accent-text); }
  .vg-w-gallery-card a:hover .vg-w-gallery-sil { color: var(--accent-text); }
  @media (max-width: 720px) { .vg-w-gallery-grid { grid-template-columns: 1fr; } }
</style>

<section class="vg-w-gallery">
  <header class="vg-w-gallery-head">
    <h1>Widgets</h1>
    <p class="vg-w-gallery-lede">{{ summary }}</p>
  </header>

  {% for group in widgets.groups %}
    <section class="vg-w-gallery-cat">
      <div class="vg-w-gallery-cat-head">
        <h2>{{ group.label }}</h2>
        <span class="vg-w-gallery-cat-sub">{{ group.sub }}</span>
        <span class="vg-w-gallery-cat-count">{{ group.items.length }} 項</span>
      </div>
      {% if group.items.length %}
        <ul class="vg-w-gallery-grid">
          {% for w in group.items %}
            <li class="vg-w-gallery-card">
              <a href="{{ w.link }}">
                {% set sil = w.id | widgetSilhouette %}
                {% if sil %}<div class="vg-w-gallery-thumb" aria-hidden="true">{{ sil | safe }}</div>{% endif %}
                <h3>{{ w.title }}</h3>
                {% if w.summary %}<p>{{ w.summary }}</p>{% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p><em>—</em></p>
      {% endif %}
    </section>
  {% endfor %}
</section>
