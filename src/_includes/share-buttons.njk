{# Share buttons partial. Usage:
   {% include "share-buttons.njk" %}
   Reads `title` and `page.url` from the calling page's context. #}
{% set shareUrl = site.url + page.url %}
{% set shareText = title %}
<aside class="vg-share" aria-label="share this post">
  <span class="vg-share-label">SHARE</span>
  <button type="button" data-vg-copy-link>{% lucide "link" %}<span class="vg-btn-label">copy link</span></button>
  <span class="vg-share-sep" aria-hidden="true">·</span>
  <a href="https://twitter.com/intent/tweet?text={{ shareText | urlencode }}&url={{ shareUrl | urlencode }}"
     target="_blank" rel="noopener">tweet</a>
  <span class="vg-share-sep" aria-hidden="true">·</span>
  <a href="https://www.threads.net/intent/post?text={{ shareText | urlencode }}%20{{ shareUrl | urlencode }}"
     target="_blank" rel="noopener">threads</a>
</aside>
