<style>
  .vg-w-feature-flags {
    display: grid;
    grid-template-columns: minmax(0, 1fr);   /* stacked: flag table on top, JSON below */
    gap: var(--s-3);
    font-family: var(--serif);
    color: var(--ink);
  }
  .vg-w-feature-flags__shell { display: contents; }
  .vg-w-feature-flags__table {
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-soft);
  }
  .vg-w-feature-flags__row {
    display: grid;
    grid-template-columns: 1fr repeat(3, auto) auto;
    column-gap: var(--s-2);
    row-gap: 0;
    padding: var(--s-2) var(--s-3);
    align-items: center;
    border-bottom: 1px solid var(--line-soft);
  }
  .vg-w-feature-flags__row:last-child { border-bottom: 0; }
  .vg-w-feature-flags__name {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    color: var(--ink);
  }
  .vg-w-feature-flags__desc {
    font-size: var(--fs-xs);
    color: var(--ink-soft);
    grid-column: 1 / -1;
    margin: var(--s-1) 0 0;
    font-family: var(--serif);
  }
  .vg-w-feature-flags__env-toggle {
    appearance: none;
    width: 2rem; height: 1rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--bg);
    position: relative;
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease;
    margin: 0;
  }
  .vg-w-feature-flags__env-toggle::before {
    content: ""; position: absolute; top: 1px; left: 1px;
    width: calc(1rem - 4px); height: calc(1rem - 4px);
    border-radius: 50%;
    background: var(--ink-soft);
    transition: transform 120ms ease, background 120ms ease;
  }
  .vg-w-feature-flags__env-toggle:checked {
    background: rgb(var(--shadow-glow) / 0.18);
    border-color: var(--accent-text);
  }
  .vg-w-feature-flags__env-toggle:checked::before {
    transform: translateX(1rem);
    background: var(--accent);
  }
  .vg-w-feature-flags__env-toggle:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .vg-w-feature-flags__pct {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--muted);
    border: 1px solid transparent;
    background: transparent;
    width: 3.5rem;
    text-align: right;
    padding: 0.1rem 0.3rem;
  }
  .vg-w-feature-flags__pct:focus-visible {
    outline: 0;
    border-color: var(--accent-text);
    color: var(--ink);
  }
  .vg-w-feature-flags__output {
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--bg-soft);
    padding: var(--s-3);
    font-family: var(--mono);
    font-size: var(--fs-xs);
    color: var(--ink);
    white-space: pre;
    overflow: auto;
    max-height: 26rem;
    margin: 0;
  }
  /* JSON syntax highlight (scoped, theme-aware site tokens) */
  .vg-w-feature-flags__output .k { color: var(--accent-text); }
  .vg-w-feature-flags__output .b { color: var(--sage-deep); }
  .vg-w-feature-flags__output .n { color: var(--ink-deep); }
  .vg-w-feature-flags__output .p { color: var(--muted-2); }
  /* Mobile overrides — placed after the base rules so they win on ties.
     Row reflows: flag name on its own line, env toggles + rollout wrap
     below, so a long mono name can't push the table past the viewport. */
  @media (max-width: 720px) {
    .vg-w-feature-flags__row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--s-2);
    }
    .vg-w-feature-flags__name { flex: 1 1 100%; }
    .vg-w-feature-flags__desc { flex: 1 1 100%; }
    .vg-w-feature-flags__pct { margin-left: auto; min-height: 44px; }
    .vg-w-feature-flags__env-toggle { width: 2.75rem; height: 1.5rem; }
    .vg-w-feature-flags__env-toggle::before {
      width: calc(1.5rem - 4px); height: calc(1.5rem - 4px);
    }
    .vg-w-feature-flags__env-toggle:checked::before {
      transform: translateX(1.25rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-feature-flags *,
    .vg-w-feature-flags *::before,
    .vg-w-feature-flags *::after {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<div class="vg-w-feature-flags__shell">
  <p class="vg-w-affordance">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor"
         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><circle cx="7" cy="16.5" r="1.5"/>
    </svg>
    <span>切換各環境開關、調整 rollout，下方 JSON 即時更新</span>
  </p>
  <div class="vg-w-feature-flags__table" data-flag-table></div>
  <pre class="vg-w-feature-flags__output" data-json-output></pre>
</div>
