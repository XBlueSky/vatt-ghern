{# head-meta.njk — OG + Twitter card + JSON-LD for any page.
   Locals expected:
     pageTitle    string  optional, defaults to site.name
     pageDesc     string  optional, defaults to site.description
     pageType     string  "article" | "website" (default "website")
     pageImage    string  absolute URL of OG image. Defaults to /static/og/home.png
     pageUrl      string  absolute URL of this page
     pageDate     string  ISO 8601 date, for articles
     jsonLdType   string  "Article" | "Blog" | "CollectionPage" | "WebPage"
                          (default "WebPage")
#}
{% set ogTitle  = pageTitle or site.name %}
{% set ogDesc   = pageDesc or site.description %}
{% set ogType   = pageType or "website" %}
{% set ogImg    = pageImage or (site.url + "/static/og/home.png") %}
{% set ogUrl    = pageUrl  or (site.url + page.url) %}
{% set ldType   = jsonLdType or "WebPage" %}
<meta name="description" content="{{ ogDesc }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ ogTitle }}">
<meta property="og:description" content="{{ ogDesc }}">
<meta property="og:type" content="{{ ogType }}">
<meta property="og:image" content="{{ ogImg }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:url" content="{{ ogUrl }}">
<meta property="og:locale" content="zh_Hant_TW">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ ogTitle }}">
<meta name="twitter:description" content="{{ ogDesc }}">
<meta name="twitter:image" content="{{ ogImg }}">
<link rel="sitemap" type="application/xml" href="/sitemap.xml">
<script type="application/ld+json">
{%- if ldType == "Article" -%}
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ ogTitle | dump }},
  "description": {{ ogDesc | dump }},
  "image": {{ ogImg | dump }},
  "url": {{ ogUrl | dump }},
  "datePublished": {{ (pageDate or "") | dump }},
  "author": { "@type": "Organization", "name": {{ site.name | dump }} },
  "publisher": { "@type": "Organization", "name": {{ site.name | dump }} },
  "inLanguage": {{ site.lang | dump }}
}
{%- elif ldType == "Blog" -%}
{
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": {{ site.name | dump }},
  "description": {{ site.description | dump }},
  "url": {{ site.url | dump }},
  "inLanguage": {{ site.lang | dump }}
}
{%- elif ldType == "CollectionPage" -%}
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ ogTitle | dump }},
  "description": {{ ogDesc | dump }},
  "url": {{ ogUrl | dump }},
  "isPartOf": { "@type": "WebSite", "name": {{ site.name | dump }}, "url": {{ site.url | dump }} }
}
{%- else -%}
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": {{ ogTitle | dump }},
  "description": {{ ogDesc | dump }},
  "url": {{ ogUrl | dump }}
}
{%- endif -%}
</script>
