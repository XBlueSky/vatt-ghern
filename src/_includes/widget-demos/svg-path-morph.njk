<style>
  .vg-w-demo-svg-path-morph {
    display: grid; gap: var(--s-3);
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-svg-path-morph svg {
    width: 100%; max-width: 240px; height: auto;
    margin: 0 auto; display: block;
  }
  .vg-w-demo-svg-path-morph .shape {
    fill: color-mix(in oklch, var(--accent), transparent 60%);
    stroke: var(--accent-text); stroke-width: 1.5;
    transition: d 700ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vg-w-demo-svg-path-morph .controls {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    align-self: center;
    margin: 0 auto;
  }
  .vg-w-demo-svg-path-morph .controls button {
    appearance: none;
    font-family: var(--mono); font-size: var(--fs-sm);
    padding: var(--s-2) var(--s-3);
    background: var(--bg-soft); border: 0;
    border-right: 1px solid var(--line);
    color: var(--ink-soft);
    cursor: pointer;
    min-height: 44px;
    transition: background 120ms, color 120ms;
  }
  .vg-w-demo-svg-path-morph .controls button:last-child { border-right: 0; }
  .vg-w-demo-svg-path-morph .controls button:hover { background: var(--bg); color: var(--ink); }
  .vg-w-demo-svg-path-morph .controls button[aria-pressed="true"] {
    background: var(--accent); color: var(--bg);
  }
  .vg-w-demo-svg-path-morph .controls button:focus-visible {
    outline: 2px solid var(--accent-text); outline-offset: -2px;
  }

  .vg-w-demo-svg-path-morph figcaption {
    margin: 0;
    display: grid; gap: var(--s-2);
  }
  .vg-w-demo-svg-path-morph figcaption .lead {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-svg-path-morph figcaption .lead code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-svg-path-morph figcaption ol {
    margin: 0; padding: 0;
    list-style: none; counter-reset: rule;
    display: grid; gap: 0.3em;
  }
  .vg-w-demo-svg-path-morph figcaption ol li {
    position: relative;
    padding-left: 2em;
    font-family: var(--serif); font-style: normal;
    font-size: var(--fs-sm); color: var(--ink);
    line-height: 1.5;
  }
  .vg-w-demo-svg-path-morph figcaption ol li::before {
    counter-increment: rule;
    content: counter(rule) '.';
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--accent-text); letter-spacing: 0.04em;
  }
  .vg-w-demo-svg-path-morph figcaption ol li code {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-svg-path-morph figcaption .hint {
    font-family: var(--sans); font-size: var(--fs-xs);
    color: var(--muted); letter-spacing: 0.04em;
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-svg-path-morph .shape { transition: none; }
    .vg-w-demo-svg-path-morph .controls button { transition: none; }
  }
</style>

<figure class="vg-w-demo-svg-path-morph">
  <svg viewBox="0 0 200 200" role="img" aria-label="shape that morphs between circle / soft / diamond">
    <path class="shape" data-shape
          d="M 100,30 C 138.66,30 170,61.34 170,100 C 170,138.66 138.66,170 100,170 C 61.34,170 30,138.66 30,100 C 30,61.34 61.34,30 100,30 Z" />
  </svg>
  <div class="controls" role="tablist">
    <button data-key="circle"  aria-pressed="true"  type="button">circle</button>
    <button data-key="soft"    aria-pressed="false" type="button">soft</button>
    <button data-key="diamond" aria-pressed="false" type="button">diamond</button>
  </div>
  <figcaption>
    <p class="lead"><code>transition: d</code> 平滑插值需要兩個條件:</p>
    <ol>
      <li>兩個 <code>d</code> 的命令數一致(M / C / L / Z 數量與順序相同)。</li>
      <li>每個 segment 的端點在兩個 <code>d</code> 裡 *同位置*。</li>
    </ol>
    <p class="hint">本檔三個 shape 共用 4 個軸向端點,只動 cubic 控制點 → 圓 → soft → 端點重合(diamond)。</p>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-svg-path-morph');
      if (!root || root.__spmBound) return;
      root.__spmBound = true;

      const path = root.querySelector('[data-shape]');
      const buttons = root.querySelectorAll('.controls button');

      // 3 個 shape 共用 4 個端點;只動 cubic 控制點。
      const PATHS = {
        circle:  'M 100,30 C 138.66,30 170,61.34 170,100 C 170,138.66 138.66,170 100,170 C 61.34,170 30,138.66 30,100 C 30,61.34 61.34,30 100,30 Z',
        soft:    'M 100,30 C 130,30 170,70 170,100 C 170,130 130,170 100,170 C 70,170 30,130 30,100 C 30,70 70,30 100,30 Z',
        diamond: 'M 100,30 C 100,30 170,100 170,100 C 170,100 100,170 100,170 C 100,170 30,100 30,100 C 30,100 100,30 100,30 Z',
      };

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          buttons.forEach(b => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          path.setAttribute('d', PATHS[btn.dataset.key]);
        });
      });
    })();
  </script>
</figure>
