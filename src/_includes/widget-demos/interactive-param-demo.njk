<style>
  .vg-w-demo-interactive-param-demo {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-3);
    margin: var(--s-3) 0 var(--s-4);
  }

  /* Controls: 2 sliders side-by-side at desktop, stacked on phones */
  .vg-w-demo-interactive-param-demo .controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3) var(--s-4);
  }
  @media (max-width: 720px) {
    .vg-w-demo-interactive-param-demo .controls { grid-template-columns: 1fr; }
  }
  .vg-w-demo-interactive-param-demo .ctl {
    display: grid;
    grid-template-columns: 1fr max-content;
    align-items: center;
    column-gap: var(--s-2);
    row-gap: 0.2rem;
  }
  .vg-w-demo-interactive-param-demo .ctl label {
    grid-column: 1 / -1;
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .vg-w-demo-interactive-param-demo .ctl output {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--accent-text);
    font-weight: 600;
    text-align: right;
    min-width: 7ch;
  }

  /* Slider — bumped thumb + larger hit area so touch can actually grab it */
  .vg-w-demo-interactive-param-demo input[type="range"] {
    appearance: none; -webkit-appearance: none;
    width: 100%;
    height: 28px;            /* hit area */
    background: transparent;
    cursor: pointer;
    touch-action: none;
    margin: 0;
  }
  .vg-w-demo-interactive-param-demo input[type="range"]:focus { outline: none; }
  .vg-w-demo-interactive-param-demo input[type="range"]:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 3px rgb(var(--shadow-glow) / 0.35);
  }
  .vg-w-demo-interactive-param-demo input[type="range"]:focus-visible::-moz-range-thumb {
    box-shadow: 0 0 0 3px rgb(var(--shadow-glow) / 0.35);
  }
  /* Webkit track + thumb */
  .vg-w-demo-interactive-param-demo input[type="range"]::-webkit-slider-runnable-track {
    height: 4px;
    background: var(--line);
    border-radius: 2px;
  }
  .vg-w-demo-interactive-param-demo input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px; height: 22px;
    margin-top: -9px;
    background: var(--accent);
    border: 2px solid var(--bg);
    border-radius: 50%;
    box-shadow: 0 1px 3px rgb(var(--shadow-warm) / 0.18);
  }
  /* Firefox track + thumb */
  .vg-w-demo-interactive-param-demo input[type="range"]::-moz-range-track {
    height: 4px;
    background: var(--line);
    border-radius: 2px;
    border: none;
  }
  .vg-w-demo-interactive-param-demo input[type="range"]::-moz-range-thumb {
    width: 22px; height: 22px;
    background: var(--accent);
    border: 2px solid var(--bg);
    border-radius: 50%;
    box-shadow: 0 1px 3px rgb(var(--shadow-warm) / 0.18);
  }

  /* Chart wrap (HTML overlay technique matches data-driven-chart) */
  .vg-w-demo-interactive-param-demo .chart-wrap {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: var(--s-3) var(--s-4) var(--s-4);
    background: var(--bg-soft);
  }
  .vg-w-demo-interactive-param-demo svg { width: 100%; height: auto; display: block; }

  .vg-w-demo-interactive-param-demo .axis     { stroke: var(--muted-2); stroke-width: 1; fill: none; }
  .vg-w-demo-interactive-param-demo .gridln   { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
  .vg-w-demo-interactive-param-demo .tickmk   { stroke: var(--muted-2); stroke-width: 1; }
  .vg-w-demo-interactive-param-demo .curve    { stroke: var(--accent); stroke-width: 1.8; fill: none; stroke-linejoin: round; }
  .vg-w-demo-interactive-param-demo .ceiling  { stroke: var(--sage); stroke-width: 1; stroke-dasharray: 4 4; fill: none; }
  .vg-w-demo-interactive-param-demo .ws-line  { stroke: var(--muted-2); stroke-width: 1; stroke-dasharray: 3 3; fill: none; }
  .vg-w-demo-interactive-param-demo .op-line  { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 2 3; fill: none; }
  .vg-w-demo-interactive-param-demo .op-dot   { fill: var(--bg); stroke: var(--accent-text); stroke-width: 2.2; }

  /* Overlay typography */
  .vg-w-demo-interactive-param-demo .overlay {
    position: absolute;
    inset: var(--s-3) var(--s-4) var(--s-4);
    pointer-events: none;
  }
  .vg-w-demo-interactive-param-demo .overlay > span {
    position: absolute;
    line-height: 1;
  }
  .vg-w-demo-interactive-param-demo .tick-y, .vg-w-demo-interactive-param-demo .tick-x {
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum";
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .vg-w-demo-interactive-param-demo .tick-y { transform: translate(-100%, -50%); padding-right: 0.4em; }
  .vg-w-demo-interactive-param-demo .tick-x { transform: translate(-50%, 0); padding-top: 0.3em; white-space: nowrap; }
  .vg-w-demo-interactive-param-demo .ws-tag {
    font-family: var(--sans);
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
    transform: translate(-50%, 0);
    padding-top: 0.4em;
    white-space: nowrap;
  }
  .vg-w-demo-interactive-param-demo .op-tag {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--accent-text);
    font-weight: 600;
    background: var(--bg);
    padding: 0.2em 0.45em;
    border: 1px solid var(--accent);
    border-radius: 3px;
    transform: translate(8px, -50%);
    white-space: nowrap;
  }

  .vg-w-demo-interactive-param-demo figcaption {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }
  .vg-w-demo-interactive-param-demo figcaption code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-interactive-param-demo input[type="range"]::-webkit-slider-thumb,
    .vg-w-demo-interactive-param-demo input[type="range"]::-moz-range-thumb { transition: none; }
  }
</style>

<figure class="vg-w-demo-interactive-param-demo"
        data-fig-question="When does cache get diminishing returns, and where exactly is the knee?"
        data-fig-template="interactive-param-demo">
  <div class="controls">
    <div class="ctl">
      <label for="ipd-cache">cache size</label>
      <input type="range" id="ipd-cache" min="1" max="200" step="1" value="60" />
      <output for="ipd-cache" id="ipd-cache-out">60 MB</output>
    </div>
    <div class="ctl">
      <label for="ipd-ws">working set</label>
      <input type="range" id="ipd-ws" min="10" max="500" step="10" value="120" />
      <output for="ipd-ws" id="ipd-ws-out">120 MB</output>
    </div>
  </div>

  <div class="chart-wrap">
    <svg viewBox="0 0 600 240" preserveAspectRatio="xMidYMid meet"
         role="img" aria-label="cache hit rate as a function of cache size, parameterized by working set"></svg>
    <div class="overlay" data-overlay></div>
  </div>

  <figcaption>
    LRU 隨機存取下的命中率飽和曲線:<code>hit ≈ 0.95 × (1 − exp(−2 × cache / working_set))</code>。
    甜蜜點落在 <code>cache ≈ working_set</code>,過了就是 diminishing returns。
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-interactive-param-demo');
      if (!root || root.__ipdBound) return;
      root.__ipdBound = true;

      const svg = root.querySelector('.chart-wrap svg');
      const overlay = root.querySelector('[data-overlay]');
      const cacheSlider = root.querySelector('#ipd-cache');
      const wsSlider = root.querySelector('#ipd-ws');
      const cacheOut = root.querySelector('#ipd-cache-out');
      const wsOut = root.querySelector('#ipd-ws-out');
      const NS = 'http://www.w3.org/2000/svg';

      const VB_W = 600, VB_H = 240;
      const PAD_L = 50, PAD_R = 24, PAD_T = 24, PAD_B = 38;
      const X0 = PAD_L, X1 = VB_W - PAD_R;
      const Y0 = VB_H - PAD_B, Y1 = PAD_T;
      const X_MAX = 200; // cache size domain (MB)
      // y=0 omitted to avoid overlapping the x=0 tick at the origin
      const yTicks = [25, 50, 75, 100]; // hit-rate %
      const xTicks = [0, 50, 100, 150, 200];

      const xOf = v => X0 + (v / X_MAX) * (X1 - X0);
      const yOf = pct => Y0 - (pct / 100) * (Y0 - Y1);
      const hitRate = (cache, ws) => 0.95 * (1 - Math.exp(-2 * cache / ws));

      function el(tag, attrs) {
        const e = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
        return e;
      }
      function pct(value, total) { return (value / total * 100).toFixed(2) + '%'; }

      // ── Static layer (rendered once) ──
      function renderStatic() {
        // gridlines + y axis tick labels
        yTicks.forEach(t => {
          const y = yOf(t);
          svg.appendChild(el('line', { class: 'gridln', x1: X0, y1: y, x2: X1, y2: y }));
          svg.appendChild(el('line', { class: 'tickmk', x1: X0 - 4, y1: y, x2: X0, y2: y }));
          const span = document.createElement('span');
          span.className = 'tick-y';
          span.textContent = t + ' %';
          span.style.left = pct(X0, VB_W);
          span.style.top  = pct(y,  VB_H);
          overlay.appendChild(span);
        });
        // axis lines
        svg.appendChild(el('line', { class: 'axis', x1: X0, y1: Y0, x2: X1, y2: Y0 }));
        svg.appendChild(el('line', { class: 'axis', x1: X0, y1: Y0, x2: X0, y2: Y1 }));
        // x axis tick marks + labels
        xTicks.forEach(t => {
          const x = xOf(t);
          svg.appendChild(el('line', { class: 'tickmk', x1: x, y1: Y0, x2: x, y2: Y0 + 4 }));
          const span = document.createElement('span');
          span.className = 'tick-x';
          span.textContent = t + ' MB';
          span.style.left = pct(x,  VB_W);
          span.style.top  = pct(Y0, VB_H);
          overlay.appendChild(span);
        });
        // saturation ceiling at 95%
        svg.appendChild(el('line', {
          class: 'ceiling',
          x1: X0, y1: yOf(95), x2: X1, y2: yOf(95),
        }));
      }

      // ── Dynamic layer (rebuilt per slider change) ──
      function renderDynamic() {
        // clear
        svg.querySelectorAll('[data-dyn]').forEach(e => e.remove());
        overlay.querySelectorAll('[data-dyn]').forEach(e => e.remove());

        const cache = parseFloat(cacheSlider.value);
        const ws = parseFloat(wsSlider.value);
        cacheOut.textContent = cache + ' MB';
        wsOut.textContent = ws + ' MB';

        // saturation curve for current ws
        const points = [];
        for (let i = 0; i <= 100; i++) {
          const c = (i / 100) * X_MAX;
          const hr = hitRate(c, ws) * 100;
          points.push((i ? 'L' : 'M') + xOf(c).toFixed(1) + ',' + yOf(hr).toFixed(1));
        }
        const curve = el('path', { class: 'curve', d: points.join(' '), 'data-dyn': '' });
        svg.appendChild(curve);

        // working-set marker: vertical dashed line at x = ws (clamped to plot)
        const wsX = xOf(Math.min(ws, X_MAX));
        svg.appendChild(el('line', {
          class: 'ws-line', 'data-dyn': '',
          x1: wsX, y1: Y0, x2: wsX, y2: Y1,
        }));
        const wsTag = document.createElement('span');
        wsTag.className = 'ws-tag';
        wsTag.setAttribute('data-dyn', '');
        wsTag.textContent = ws > X_MAX ? 'WS (off-chart)' : 'working_set';
        wsTag.style.left = pct(wsX, VB_W);
        wsTag.style.top  = pct(Y1 - 14, VB_H);
        overlay.appendChild(wsTag);

        // operating point
        const hr = hitRate(cache, ws);
        const dotX = xOf(cache);
        const dotY = yOf(hr * 100);
        // drop-lines: from dot to x-axis and y-axis
        svg.appendChild(el('line', {
          class: 'op-line', 'data-dyn': '',
          x1: dotX, y1: dotY, x2: dotX, y2: Y0,
        }));
        svg.appendChild(el('line', {
          class: 'op-line', 'data-dyn': '',
          x1: dotX, y1: dotY, x2: X0, y2: dotY,
        }));
        svg.appendChild(el('circle', {
          class: 'op-dot', 'data-dyn': '',
          cx: dotX, cy: dotY, r: 5.5,
        }));
        // op tag — "cache / hit%" readout
        const opTag = document.createElement('span');
        opTag.className = 'op-tag';
        opTag.setAttribute('data-dyn', '');
        opTag.textContent = (hr * 100).toFixed(1) + ' %';
        opTag.style.left = pct(dotX, VB_W);
        opTag.style.top  = pct(dotY, VB_H);
        overlay.appendChild(opTag);
      }

      renderStatic();
      renderDynamic();
      cacheSlider.addEventListener('input', renderDynamic);
      wsSlider.addEventListener('input', renderDynamic);
    })();
  </script>
</figure>
