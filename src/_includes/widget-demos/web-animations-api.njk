<style>
  .vg-w-demo-web-animations-api {
    display: grid; gap: var(--s-3);
    margin: var(--s-3) 0 var(--s-4);
    padding: var(--s-4);
    background: var(--bg-soft);
    border: 1px solid var(--line); border-radius: 6px;
  }

  /* Target —— status badge,接 view-transition-api / matter-of-fact-table 的
     build pipeline 故事 */
  .vg-w-demo-web-animations-api .stage {
    height: 80px;
    display: flex; align-items: center;
    padding: 0 var(--s-3);
    overflow: hidden;
  }
  .vg-w-demo-web-animations-api .badge {
    display: inline-flex; align-items: center; gap: 0.5em;
    padding: var(--s-2) var(--s-3);
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 999px;
    font-family: var(--mono); font-size: var(--fs-sm);
    color: var(--accent-text); font-weight: 600;
    letter-spacing: 0.04em;
    transform-origin: center center;
    /* will-change 提示瀏覽器這塊會 transform,compositing layer 提前準備 */
    will-change: transform;
  }
  .vg-w-demo-web-animations-api .badge .dot {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--accent);
  }

  .vg-w-demo-web-animations-api .controls {
    display: inline-flex;
    border: 1px solid var(--line); border-radius: 6px;
    overflow: hidden;
    align-self: start;
  }
  .vg-w-demo-web-animations-api .controls button {
    appearance: none;
    font-family: var(--mono); font-size: var(--fs-sm);
    padding: var(--s-2) var(--s-3);
    min-height: 44px;
    background: var(--bg); border: 0;
    border-right: 1px solid var(--line);
    color: var(--ink-soft); cursor: pointer;
    transition: background 120ms, color 120ms;
  }
  .vg-w-demo-web-animations-api .controls button:last-child { border-right: 0; }
  .vg-w-demo-web-animations-api .controls button:hover { background: var(--bg-soft); color: var(--ink); }
  .vg-w-demo-web-animations-api .controls button:focus-visible {
    outline: 2px solid var(--accent-text); outline-offset: -2px;
  }

  .vg-w-demo-web-animations-api figcaption { margin: 0; display: grid; gap: var(--s-2); }
  .vg-w-demo-web-animations-api figcaption .lead {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-web-animations-api figcaption .lead code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-web-animations-api figcaption ol {
    margin: 0; padding: 0;
    list-style: none; counter-reset: rule;
    display: grid; gap: 0.35em;
  }
  .vg-w-demo-web-animations-api figcaption ol li {
    position: relative;
    padding-left: 2.2em;
    font-family: var(--serif); font-style: normal;
    font-size: var(--fs-sm); color: var(--ink);
    line-height: 1.55;
  }
  .vg-w-demo-web-animations-api figcaption ol li::before {
    counter-increment: rule;
    content: counter(rule) '.';
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--accent-text);
    letter-spacing: 0.04em;
  }
  .vg-w-demo-web-animations-api figcaption ol li code {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-web-animations-api figcaption .hint {
    font-family: var(--sans); font-size: var(--fs-xs);
    color: var(--muted); letter-spacing: 0.04em;
    margin: 0;
  }
  .vg-w-demo-web-animations-api figcaption .hint code {
    font-family: var(--mono); font-size: 0.95em;
    color: var(--ink-soft);
  }
</style>

<figure class="vg-w-demo-web-animations-api">
  <div class="stage">
    <span class="badge" data-target>
      <span class="dot"></span>
      build-12835
    </span>
  </div>

  <div class="controls" role="toolbar" aria-label="animation triggers">
    <button data-act="slide" type="button">slide</button>
    <button data-act="spin"  type="button">spin</button>
    <button data-act="pulse" type="button">pulse</button>
  </div>

  <figcaption>
    <p class="lead">WAAPI 比純 CSS keyframes 多三件事:</p>
    <ol>
      <li>即時控制狀態:<code>.pause</code> / <code>.play</code> / <code>.cancel</code> / <code>.reverse</code>。</li>
      <li><code>.finished</code> 是 Promise,可 <code>await</code> 串下一個動作。</li>
      <li>keyframes 是 JS array,參數可動態算出來。</li>
    </ol>
    <p class="hint">點按鈕看 badge 動。<code>prefers-reduced-motion</code> 開時 duration 自動降 1ms。</p>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-web-animations-api');
      if (!root || root.__waaBound) return;
      root.__waaBound = true;

      const target = root.querySelector('[data-target]');
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const MOVES = {
        slide: [
          { transform: 'translateX(0)' },
          { transform: 'translateX(180px)' },
          { transform: 'translateX(0)' },
        ],
        spin: [
          { transform: 'rotate(0)' },
          { transform: 'rotate(360deg)' },
        ],
        pulse: [
          { transform: 'scale(1)' },
          { transform: 'scale(1.18)' },
          { transform: 'scale(1)' },
        ],
      };

      let current = null;

      root.querySelectorAll('.controls button').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (current) current.cancel();
          current = target.animate(MOVES[btn.dataset.act], {
            // reduced-motion → 1ms 直接跳到最後 frame,等同沒動畫
            duration: reduced ? 1 : 900,
            easing: 'cubic-bezier(0.16, 1, 0.3, 1)',
          });
          // 示範 .finished promise:動畫結束 button 可以 disabled→enabled
          // 之類。這邊只用來示意,實際用途多。
          try {
            await current.finished;
          } catch (err) {
            /* 動畫被 cancel() 會 reject,正常 ignore */
          }
        });
      });
    })();
  </script>
</figure>
