<style>
  .vg-w-demo-range-input-binding {
    display: grid; gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    background: var(--bg-soft);
    border: 1px solid var(--line); border-radius: 6px;
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-range-input-binding .controls {
    display: grid;
    grid-template-columns: max-content 1fr max-content;
    gap: var(--s-3);
    align-items: center;
  }
  .vg-w-demo-range-input-binding .controls label {
    font-family: var(--sans); font-size: var(--fs-xs);
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted);
  }
  .vg-w-demo-range-input-binding .controls output {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm); color: var(--accent-text);
    font-weight: 600; min-width: 5ch; text-align: right;
  }

  /* Slider —— bumped thumb 22px + 28px hit area,跟 interactive-param-demo
     同 idiom。native ~12px thumb 行動端抓不到。 */
  .vg-w-demo-range-input-binding input[type="range"] {
    appearance: none; -webkit-appearance: none;
    width: 100%; height: 28px;
    background: transparent; cursor: pointer; touch-action: none;
    margin: 0;
  }
  .vg-w-demo-range-input-binding input[type="range"]:focus { outline: none; }
  .vg-w-demo-range-input-binding input[type="range"]::-webkit-slider-runnable-track {
    height: 4px; background: var(--line); border-radius: 2px;
  }
  .vg-w-demo-range-input-binding input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 22px; height: 22px; margin-top: -9px;
    background: var(--accent); border: 2px solid var(--bg);
    border-radius: 50%;
    box-shadow: 0 1px 3px rgb(var(--shadow-warm) / 0.18);
  }
  .vg-w-demo-range-input-binding input[type="range"]::-moz-range-track {
    height: 4px; background: var(--line); border-radius: 2px;
  }
  .vg-w-demo-range-input-binding input[type="range"]::-moz-range-thumb {
    width: 22px; height: 22px;
    background: var(--accent); border: 2px solid var(--bg);
    border-radius: 50%;
  }

  .vg-w-demo-range-input-binding .preview {
    margin: 0;
    padding: var(--s-3) var(--s-4);
    background: var(--bg);
    border-top: 1px solid var(--line);
    border-radius: 4px;
    font-family: var(--serif); font-style: italic;
    color: var(--ink);
    line-height: 1.45;
    /* font-size 由 JS 即時改 */
  }

  .vg-w-demo-range-input-binding figcaption {
    margin: 0;
    display: grid; gap: 0.3em;
  }
  .vg-w-demo-range-input-binding figcaption .why {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55;
  }
  .vg-w-demo-range-input-binding figcaption .why code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-range-input-binding figcaption .hint {
    font-family: var(--sans); font-size: var(--fs-xs);
    color: var(--muted); letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-range-input-binding input[type="range"]::-webkit-slider-thumb,
    .vg-w-demo-range-input-binding input[type="range"]::-moz-range-thumb { transition: none; }
  }
</style>

<figure class="vg-w-demo-range-input-binding">
  <div class="controls">
    <label for="rib-fs">font size</label>
    <input type="range" id="rib-fs" min="14" max="48" step="1" value="22" />
    <output for="rib-fs" data-output>22 px</output>
  </div>
  <p class="preview" data-preview style="font-size: 22px;">Spectral 在這個大小看起來怎麼樣?拉滑桿看實際渲染。</p>
  <figcaption>
    <p class="why">
      <code>&lt;output for="rib-fs"&gt;</code> 跟 slider 用 <code>for</code> 屬性關聯,瀏覽器把它當成「該 input 的計算結果」;預設帶 <code>aria-live="polite"</code>,SR 會自動播報變動,不用自己加 ARIA。
    </p>
    <p class="hint">
      slider 連結到 <em>兩個</em> DOM 節點:右上 <code>&lt;output&gt;</code>(顯示數字)+ 下方預覽 <code>&lt;p&gt;</code> 的 <code>font-size</code>(實際效果)。
    </p>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-range-input-binding');
      if (!root || root.__ribBound) return;
      root.__ribBound = true;

      const slider = root.querySelector('input[type="range"]');
      const output = root.querySelector('[data-output]');
      const preview = root.querySelector('[data-preview]');

      function sync() {
        const v = slider.value;
        output.value = v + ' px';
        preview.style.fontSize = v + 'px';
      }
      slider.addEventListener('input', sync);
      sync();
    })();
  </script>
</figure>
