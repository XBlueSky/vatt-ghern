<style>
  .vg-w-demo-tooltip-popover-anchor {
    margin: var(--s-3) 0 var(--s-4);
    padding: var(--s-4);
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-family: var(--serif); font-size: var(--fs-sm);
    color: var(--ink-soft);
    line-height: 1.7;
  }

  /* Anchor —— inline text 加 anchor-name + visible dotted underline 表明
     有 tooltip 可看。anchor-name 是 CSS Anchor Positioning 的入口。 */
  .vg-w-demo-tooltip-popover-anchor .anchor {
    color: var(--accent-text);
    border-bottom: 1px dotted var(--accent);
    cursor: help;
    outline: none;
    anchor-name: --pop-anchor;
  }
  .vg-w-demo-tooltip-popover-anchor .anchor:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  /* Popover —— position-anchor 對到上面的 anchor-name;anchor() 函式
     從 anchor 元素讀邊界座標。bottom: anchor(top) 把 popover 底邊放在
     anchor 頂邊;justify-self: anchor-center 水平置中。 */
  .vg-w-demo-tooltip-popover-anchor .popover {
    position: absolute;
    position-anchor: --pop-anchor;
    bottom: anchor(top);
    justify-self: anchor-center;
    margin-bottom: 10px;
    width: 280px; max-width: calc(100vw - 32px);
    padding: var(--s-2) var(--s-3);
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 6px;
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-xs);
    color: var(--ink);
    line-height: 1.55;
    box-shadow: 0 4px 12px rgb(var(--shadow-warm) / 0.12);
    opacity: 0; pointer-events: none;
    transition: opacity 200ms;
    z-index: 2;
  }
  /* Tooltip 內統一 italic serif —— 拿掉 mono code 樣式避免字體混雜。
     技術名詞由詞義被識別,不用視覺特殊化。 */
  .vg-w-demo-tooltip-popover-anchor .popover code {
    font-family: inherit; font-style: inherit;
    font-size: inherit; background: transparent;
    padding: 0; border-radius: 0; color: inherit;
  }
  .vg-w-demo-tooltip-popover-anchor .popover::after {
    content: "";
    position: absolute;
    top: 100%; left: 50%;
    transform: translateX(-50%);
    border: 6px solid transparent;
    border-top-color: var(--accent);
  }
  .vg-w-demo-tooltip-popover-anchor .anchor:hover ~ .popover,
  .vg-w-demo-tooltip-popover-anchor .anchor:focus-visible ~ .popover,
  .vg-w-demo-tooltip-popover-anchor .anchor + .popover:hover {
    opacity: 1; pointer-events: auto;
  }

  /* Fallback —— 不支援 anchor-name 的瀏覽器(2026 Firefox 還未支援)
     用傳統 parent-relative absolute positioning。anchor 的父 span 自然有
     寬度可作 reference,popover 對它定位。 */
  @supports not (anchor-name: --x) {
    .vg-w-demo-tooltip-popover-anchor .anchor {
      position: relative;
      display: inline-block;
    }
    .vg-w-demo-tooltip-popover-anchor .popover {
      position-anchor: auto;  /* reset(no-op on unsupported)*/
      bottom: calc(100% + 10px);
      left: 50%;
      transform: translateX(-50%);
      justify-self: auto;
      margin-bottom: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-tooltip-popover-anchor .popover { transition: none; }
  }
</style>

<figure class="vg-w-demo-tooltip-popover-anchor">
  ld binding 順序 bug 只在
  <span class="anchor" tabindex="0">「dlopen 多個 <code>.so</code> 再依序 dlclose」</span><span class="popover" role="tooltip">
    第一次 <code>dlopen libsynow3</code> 後 <code>dlclose</code>、然後 <code>dlopen libsynosharing</code> —— 第二次 dlopen 因 GOT 殘留 mapping 觸發 <code>SIGSEGV</code>。glibc &lt; 2.34 已知議題。
  </span>
  這條路徑會踩到。
</figure>
