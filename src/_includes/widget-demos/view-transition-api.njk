<style>
  .vg-w-demo-view-transition-api {
    display: grid; gap: var(--s-3);
    margin: var(--s-3) 0 var(--s-4);
  }

  .vg-w-demo-view-transition-api .controls {
    display: inline-flex;
    border: 1px solid var(--line); border-radius: 6px;
    overflow: hidden;
    align-self: start;
  }
  .vg-w-demo-view-transition-api .controls button {
    appearance: none;
    font-family: var(--mono); font-size: var(--fs-sm);
    padding: var(--s-2) var(--s-3);
    min-height: 44px;
    background: var(--bg-soft); border: 0;
    border-right: 1px solid var(--line);
    color: var(--ink-soft); cursor: pointer;
    transition: background 120ms, color 120ms;
  }
  .vg-w-demo-view-transition-api .controls button:last-child { border-right: 0; }
  .vg-w-demo-view-transition-api .controls button:hover { background: var(--bg); color: var(--ink); }
  .vg-w-demo-view-transition-api .controls button[aria-pressed="true"] {
    background: var(--accent); color: var(--bg);
  }
  .vg-w-demo-view-transition-api .controls button:focus-visible {
    outline: 2px solid var(--accent-text); outline-offset: -2px;
  }

  .vg-w-demo-view-transition-api .panel {
    padding: var(--s-3) var(--s-4);
    background: var(--bg-soft);
    border: 1px solid var(--line); border-radius: 6px;
    min-height: 140px;
    /* 給 view-transition-name 讓瀏覽器自動 capture 這塊做 crossfade */
    view-transition-name: vt-panel;
  }
  .vg-w-demo-view-transition-api .panel .head {
    display: flex; align-items: baseline; gap: var(--s-2);
    margin: 0 0 var(--s-2);
  }
  .vg-w-demo-view-transition-api .panel .name {
    font-family: var(--display); font-style: italic;
    font-size: var(--fs-md); color: var(--ink);
    font-weight: 500;
  }
  .vg-w-demo-view-transition-api .panel .status {
    font-family: var(--mono); font-size: var(--fs-xs);
    letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.15em 0.5em; border-radius: 3px;
    font-weight: 600;
  }
  .vg-w-demo-view-transition-api .panel[data-state="queued"]  .status {
    background: color-mix(in oklch, var(--muted), transparent 70%);
    color: var(--ink-soft);
  }
  .vg-w-demo-view-transition-api .panel[data-state="running"] .status {
    background: color-mix(in oklch, var(--accent), transparent 70%);
    color: var(--accent-text);
  }
  .vg-w-demo-view-transition-api .panel[data-state="passed"]  .status {
    background: color-mix(in oklch, var(--sage), transparent 70%);
    color: var(--sage-deep);
  }
  .vg-w-demo-view-transition-api .panel .body {
    font-family: var(--serif); font-size: var(--fs-sm);
    color: var(--ink-soft); line-height: 1.65;
    margin: 0;
  }
  .vg-w-demo-view-transition-api .panel .body code {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg); padding: 0.05em 0.32em; border-radius: 3px;
    color: var(--ink);
  }
  .vg-w-demo-view-transition-api .panel .meta {
    margin: var(--s-2) 0 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); color: var(--muted);
    letter-spacing: 0.04em;
  }

  /* View Transition crossfade —— old fade-out 同時 new fade-in,合成 cross-dissolve */
  @keyframes vt-fade-in  { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @keyframes vt-fade-out { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateY(-6px); } }
  ::view-transition-old(vt-panel) { animation: vt-fade-out 260ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  ::view-transition-new(vt-panel) { animation: vt-fade-in  260ms cubic-bezier(0.16, 1, 0.3, 1) forwards; }
  @media (prefers-reduced-motion: reduce) {
    ::view-transition-old(vt-panel),
    ::view-transition-new(vt-panel) { animation: none; }
    .vg-w-demo-view-transition-api .controls button { transition: none; }
  }

  .vg-w-demo-view-transition-api .unsupported {
    font-family: var(--mono); font-size: var(--fs-xs);
    color: var(--muted); margin: 0;
  }

  .vg-w-demo-view-transition-api figcaption { margin: 0; display: grid; gap: var(--s-2); }
  .vg-w-demo-view-transition-api figcaption .lead {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-view-transition-api figcaption .lead code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-view-transition-api figcaption ol {
    margin: 0; padding: 0;
    list-style: none; counter-reset: rule;
    display: grid; gap: 0.3em;
  }
  .vg-w-demo-view-transition-api figcaption ol li {
    position: relative;
    padding-left: 2em;
    font-family: var(--serif); font-style: normal;
    font-size: var(--fs-sm); color: var(--ink);
    line-height: 1.5;
  }
  .vg-w-demo-view-transition-api figcaption ol li::before {
    counter-increment: rule;
    content: counter(rule) '.';
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--accent-text); letter-spacing: 0.04em;
  }
  .vg-w-demo-view-transition-api figcaption ol li code {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
</style>

<figure class="vg-w-demo-view-transition-api">
  <div class="controls" role="tablist">
    <button data-state="queued"  aria-pressed="true"  type="button">queued</button>
    <button data-state="running" aria-pressed="false" type="button">running</button>
    <button data-state="passed"  aria-pressed="false" type="button">passed</button>
  </div>

  <div class="panel" data-panel data-state="queued">
    <p class="head">
      <span class="name">build-12835</span>
      <span class="status" data-status>queued</span>
    </p>
    <p class="body" data-body>等 runner 接手 · agent pool 滿了正在 backfill。</p>
    <p class="meta" data-meta>position #4 in queue · ETA 1m 20s</p>
  </div>

  <p class="unsupported" data-warn></p>

  <figcaption>
    <p class="lead">View Transition API 把任意 DOM 變動包成可動畫的「old → new」過渡 —— 三件套:</p>
    <ol>
      <li><code>document.startViewTransition(updateFn)</code> 開始一次 transition,callback 內做 DOM 更新。</li>
      <li><code>view-transition-name: vt-panel</code> 標記哪塊要被 capture(snapshot old + new)。</li>
      <li><code>::view-transition-old(vt-panel)</code> 與 <code>::view-transition-new(vt-panel)</code> pseudo-element 上掛 CSS keyframes,定義過渡長相。</li>
    </ol>
    <p class="lead">點按鈕切換 build 狀態,看 panel 在 old → new 間 crossfade + 微微 translate Y。</p>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-view-transition-api');
      if (!root || root.__vtBound) return;
      root.__vtBound = true;

      const panel = root.querySelector('[data-panel]');
      const nameEl = panel.querySelector('.name');
      const statusEl = root.querySelector('[data-status]');
      const bodyEl = root.querySelector('[data-body]');
      const metaEl = root.querySelector('[data-meta]');
      const warn = root.querySelector('[data-warn]');
      const buttons = root.querySelectorAll('.controls button');

      if (!document.startViewTransition) {
        warn.textContent = '⚠ document.startViewTransition 在此瀏覽器不支援 —— 仍會切內容,但沒過渡動畫。';
      }

      const STATES = {
        queued: {
          status: 'queued',
          body: '等 runner 接手。agent pool 滿了正在 backfill 新 instance。',
          meta: 'position #4 in queue · ETA 1m 20s',
        },
        running: {
          status: 'running',
          body: '<code>runner-07</code> 拉了 commit,跑 <code>make test</code>,目前在 <code>webapi_entry_test</code>。',
          meta: 'elapsed 2m 14s · 312 / 484 tests',
        },
        passed: {
          status: 'passed',
          body: '所有 test pass,artifact 上傳完成,tag <code>build-12835</code> 推到 registry。',
          meta: 'total 4m 02s · coverage 78.4%',
        },
      };

      function paint(key) {
        const s = STATES[key];
        panel.setAttribute('data-state', key);
        statusEl.textContent = s.status;
        bodyEl.innerHTML = s.body;
        metaEl.textContent = s.meta;
        buttons.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.state === key)));
      }

      buttons.forEach(b => {
        b.addEventListener('click', () => {
          const fn = () => paint(b.dataset.state);
          if (document.startViewTransition) document.startViewTransition(fn);
          else fn();
        });
      });
    })();
  </script>
</figure>
