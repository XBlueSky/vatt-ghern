<style>
  .vg-w-demo-before-after-slider {
    position: relative;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 2 / 1;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    margin: var(--s-3) 0 var(--s-4);
    background: var(--bg-soft);
    user-select: none;
  }
  .vg-w-demo-before-after-slider .layer {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    display: block;
    background: var(--bg-soft);
  }
  .vg-w-demo-before-after-slider .layer.after {
    clip-path: inset(0 0 0 var(--bas-pos, 50%));
  }
  .vg-w-demo-before-after-slider .layer .node {
    fill: var(--bg);
    stroke: var(--muted-2);
    stroke-width: 1.2;
  }
  .vg-w-demo-before-after-slider .layer .label {
    font-family: var(--serif);
    font-style: italic;
    font-size: 11px;
    fill: var(--ink);
    text-anchor: middle;
    dominant-baseline: middle;
  }
  /* Before:亂麻 mesh —— 灰色 dashed,3 條相鄰 + 3 條 bypass curve */
  .vg-w-demo-before-after-slider .layer.before .edge {
    stroke: var(--muted-2);
    stroke-width: 1;
    fill: none;
    stroke-dasharray: 3 3;
  }
  /* After:乾淨 pipeline —— 赭紅單向實線、有箭頭 */
  .vg-w-demo-before-after-slider .layer.after .edge {
    stroke: var(--accent);
    stroke-width: 1.4;
    fill: none;
  }
  /* After-only:layer caption,scribed italic 赭紅 marginalia */
  .vg-w-demo-before-after-slider .layer.after .role {
    font-family: var(--scribed);
    font-style: italic;
    font-size: 9px;
    fill: var(--accent-text);
    text-anchor: middle;
    letter-spacing: 0.02em;
  }

  .vg-w-demo-before-after-slider .label-tag {
    position: absolute;
    top: var(--s-2);
    z-index: 2;
    padding: 0.15em 0.5em;
    font-family: var(--sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--muted);
  }
  .vg-w-demo-before-after-slider .label-tag.before { left: var(--s-2); }
  .vg-w-demo-before-after-slider .label-tag.after  { right: var(--s-2); color: var(--accent-text); border-color: var(--accent); }

  .vg-w-demo-before-after-slider .divider {
    position: absolute;
    top: 0; bottom: 0;
    width: 2px;
    background: var(--accent);
    left: var(--bas-pos, 50%);
    transform: translateX(-1px);
    cursor: ew-resize;
    touch-action: none;
    z-index: 3;
  }
  .vg-w-demo-before-after-slider .divider .handle {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 44px; height: 44px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 1px 4px rgb(var(--shadow-warm) / 0.18);
    cursor: ew-resize;
  }
  .vg-w-demo-before-after-slider .divider .handle::before,
  .vg-w-demo-before-after-slider .divider .handle::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 0; height: 0;
    border: 4px solid transparent;
    transform: translateY(-50%);
  }
  .vg-w-demo-before-after-slider .divider .handle::before { left: 8px;  border-right-color: var(--bg); }
  .vg-w-demo-before-after-slider .divider .handle::after  { right: 8px; border-left-color:  var(--bg); }
  .vg-w-demo-before-after-slider .divider:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 4px;
  }
</style>

<figure class="vg-w-demo-before-after-slider" style="--bas-pos: 50%;">
  <!-- BEFORE:4 節點水平 pipeline、3 條相鄰 + 3 條 bypass 高低不一的弧線
       —— 表現「UI 直接跳過中間層去找 Cache / DB」的耦合崩潰 -->
  <svg class="layer before" viewBox="0 0 320 160" aria-hidden="true">
    <!-- 相鄰平直連線 -->
    <line class="edge" x1="70"  y1="85"  x2="100" y2="85" />
    <line class="edge" x1="150" y1="85"  x2="180" y2="85" />
    <line class="edge" x1="230" y1="85"  x2="260" y2="85" />
    <!-- Bypass 弧線(往上跨越中間節點)-->
    <path class="edge" d="M 45 70 Q 125 25 205 70" />
    <path class="edge" d="M 45 70 Q 165 8 285 70" />
    <path class="edge" d="M 125 70 Q 205 25 285 70" />
    <!-- 4 節點 -->
    <rect class="node" x="20"  y="70" width="50" height="30" rx="6" />
    <rect class="node" x="100" y="70" width="50" height="30" rx="6" />
    <rect class="node" x="180" y="70" width="50" height="30" rx="6" />
    <rect class="node" x="260" y="70" width="50" height="30" rx="6" />
    <text class="label" x="45"  y="85">UI</text>
    <text class="label" x="125" y="85">API</text>
    <text class="label" x="205" y="85">Cache</text>
    <text class="label" x="285" y="85">DB</text>
  </svg>

  <!-- AFTER:同 4 節點,3 條乾淨單向箭頭 + 下方 scribed italic 層名 -->
  <svg class="layer after" viewBox="0 0 320 160">
    <defs>
      <marker id="bas-arrow" viewBox="0 0 10 10" refX="9" refY="5"
              markerWidth="6" markerHeight="6" orient="auto">
        <path d="M0,0 L10,5 L0,10 z" fill="var(--accent)" />
      </marker>
    </defs>
    <!-- 3 條相鄰、單向、有箭頭 -->
    <line class="edge" x1="72"  y1="85" x2="98"  y2="85" marker-end="url(#bas-arrow)" />
    <line class="edge" x1="152" y1="85" x2="178" y2="85" marker-end="url(#bas-arrow)" />
    <line class="edge" x1="232" y1="85" x2="258" y2="85" marker-end="url(#bas-arrow)" />
    <!-- 4 節點(位置與 before 一致)-->
    <rect class="node" x="20"  y="70" width="50" height="30" rx="6" />
    <rect class="node" x="100" y="70" width="50" height="30" rx="6" />
    <rect class="node" x="180" y="70" width="50" height="30" rx="6" />
    <rect class="node" x="260" y="70" width="50" height="30" rx="6" />
    <text class="label" x="45"  y="85">UI</text>
    <text class="label" x="125" y="85">API</text>
    <text class="label" x="205" y="85">Cache</text>
    <text class="label" x="285" y="85">DB</text>
    <!-- Layer captions(scribed italic 赭紅)—— wipe 過去才出現,marginalia 感 -->
    <text class="role" x="45"  y="120">presentation</text>
    <text class="role" x="125" y="120">adapter</text>
    <text class="role" x="205" y="120">read-through</text>
    <text class="role" x="285" y="120">source</text>
  </svg>

  <span class="label-tag before">before · mesh</span>
  <span class="label-tag after">after · pipeline</span>

  <div class="divider" role="slider" tabindex="0"
       aria-label="reveal position"
       aria-valuemin="0" aria-valuemax="100" aria-valuenow="50">
    <span class="handle" aria-hidden="true"></span>
  </div>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-before-after-slider');
      if (!root || root.__basBound) return;
      root.__basBound = true;

      const divider = root.querySelector('.divider');
      let dragging = false;

      function setPos(x) {
        const r = root.getBoundingClientRect();
        const pct = Math.max(0, Math.min(100, ((x - r.left) / r.width) * 100));
        root.style.setProperty('--bas-pos', pct + '%');
        divider.setAttribute('aria-valuenow', pct.toFixed(0));
      }

      divider.addEventListener('pointerdown', e => {
        dragging = true;
        divider.setPointerCapture(e.pointerId);
        setPos(e.clientX);
        e.preventDefault();
      });
      divider.addEventListener('pointermove', e => {
        if (dragging) setPos(e.clientX);
      });
      divider.addEventListener('pointerup',     () => { dragging = false; });
      divider.addEventListener('pointercancel', () => { dragging = false; });

      divider.addEventListener('keydown', e => {
        const cur = parseFloat(divider.getAttribute('aria-valuenow'));
        let next = cur;
        if (e.key === 'ArrowLeft')  next = Math.max(0, cur - 5);
        else if (e.key === 'ArrowRight') next = Math.min(100, cur + 5);
        else if (e.key === 'Home')  next = 0;
        else if (e.key === 'End')   next = 100;
        else return;
        e.preventDefault();
        root.style.setProperty('--bas-pos', next + '%');
        divider.setAttribute('aria-valuenow', next);
      });
    })();
  </script>
</figure>
