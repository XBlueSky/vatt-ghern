<style>
  .vg-w-demo-css-container-query {
    display: grid; gap: var(--s-2);
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-css-container-query .stage {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: var(--s-4);
    overflow: hidden;
  }

  /* Resizable container — 用 inline-size 當 container query 基準 */
  .vg-w-demo-css-container-query .resizable {
    container-type: inline-size;
    position: relative;
    width: 65%;
    min-width: 180px;
    max-width: 100%;
    background: var(--bg);
    border: 1px solid var(--accent);
    border-radius: 4px;
    padding: var(--s-3) calc(var(--s-3) + 14px) var(--s-3) var(--s-3);
    user-select: none;
  }

  /* Drag handle:44+ tap target,終端有兩條短橫線 */
  .vg-w-demo-css-container-query .resizer {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 28px;
    background: transparent;
    border: 0; padding: 0;
    cursor: ew-resize;
    touch-action: none;
  }
  .vg-w-demo-css-container-query .resizer::before {
    content: "";
    position: absolute;
    top: 50%; right: 8px;
    transform: translateY(-50%);
    width: 6px; height: 36px;
    background: var(--accent);
    border-radius: 3px;
    box-shadow: 0 0 0 2px var(--bg);
  }
  .vg-w-demo-css-container-query .resizer:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }

  /* Card content —— 預設 1-col stacked */
  .vg-w-demo-css-container-query .card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-1) var(--s-3);
    align-items: baseline;
    font-family: var(--serif);
    font-size: var(--fs-sm);
    color: var(--ink-soft);
  }
  .vg-w-demo-css-container-query .card .title {
    font-weight: 600; color: var(--ink);
    font-family: var(--mono); font-size: var(--fs-sm);
  }
  .vg-w-demo-css-container-query .card .meta {
    font-family: var(--mono); font-size: var(--fs-xs);
    color: var(--muted);
  }
  .vg-w-demo-css-container-query .card .status {
    font-family: var(--sans); font-size: var(--fs-xs);
    font-weight: 600; letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sage-deep);
    background: color-mix(in oklch, var(--sage), transparent 78%);
    padding: 0.15em 0.5em;
    border-radius: 3px;
    width: max-content;
  }

  /* Breakpoint 1:容器 ≥ 320 → 2-col(title | meta-right),status 換行 */
  @container (min-width: 320px) {
    .vg-w-demo-css-container-query .card {
      grid-template-columns: 1fr max-content;
    }
    .vg-w-demo-css-container-query .card .meta { text-align: right; }
    .vg-w-demo-css-container-query .card .status { grid-column: 1 / -1; }
  }
  /* Breakpoint 2:容器 ≥ 480 → 3-col(title | meta | status pill) */
  @container (min-width: 480px) {
    .vg-w-demo-css-container-query .card {
      grid-template-columns: 1fr max-content max-content;
      align-items: center;
    }
    .vg-w-demo-css-container-query .card .meta { text-align: right; }
    .vg-w-demo-css-container-query .card .status { grid-column: auto; }
  }

  .vg-w-demo-css-container-query .readout {
    display: flex; justify-content: space-between;
    align-items: baseline;
    margin: var(--s-2) 0 0;
    padding: 0 0.2rem;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .vg-w-demo-css-container-query .readout .value {
    color: var(--accent-text); font-weight: 600;
  }
  .vg-w-demo-css-container-query .readout .breakpoint {
    color: var(--ink-soft);
  }

  .vg-w-demo-css-container-query figcaption {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.6; margin: 0;
  }
  .vg-w-demo-css-container-query figcaption code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-css-container-query figcaption ol {
    margin: var(--s-2) 0; padding: 0;
    list-style: none; counter-reset: rule;
    display: grid; gap: 0.3em;
  }
  .vg-w-demo-css-container-query figcaption ol li {
    position: relative;
    padding-left: 2em;
    font-style: normal; color: var(--ink);
  }
  .vg-w-demo-css-container-query figcaption ol li::before {
    counter-increment: rule;
    content: counter(rule) '.';
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--accent-text); letter-spacing: 0.04em;
  }
  .vg-w-demo-css-container-query figcaption ol li b {
    font-family: var(--mono); font-style: normal;
    font-weight: 600; color: var(--accent-text);
    margin-right: 0.4em;
  }
  .vg-w-demo-css-container-query figcaption .takeaway {
    margin-top: var(--s-2);
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    /* drag 不算動畫,沒有 transition,nothing to disable */
  }
</style>

<figure class="vg-w-demo-css-container-query">
  <div class="stage">
    <div class="resizable" data-resizable>
      <div class="card">
        <span class="title">build-12835</span>
        <span class="meta">2026-05-21 · 52s</span>
        <span class="status">passed</span>
      </div>
      <button class="resizer" type="button"
              data-resizer
              role="separator"
              aria-orientation="vertical"
              aria-label="resize container"
              aria-valuemin="180" aria-valuemax="600" aria-valuenow="0"
              tabindex="0"></button>
    </div>
    <p class="readout">
      <span>container <span class="value" data-width>—</span> px</span>
      <span class="breakpoint" data-breakpoint>—</span>
    </p>
  </div>
  <figcaption>
    抓右邊把手橫向縮放,看 card 跨兩個 <code>@container</code> 斷點重排:
    <ol>
      <li><b>&lt; 320</b>title / meta / status 三段堆疊</li>
      <li><b>≥ 320</b>title | meta 並排;status 換行</li>
      <li><b>≥ 480</b>title | meta | status pill 三欄</li>
    </ol>
    <span class="takeaway">breakpoint 看 container 寬度、不是 viewport —— 同一個 card 放進任何寬度的容器都自己挑對 layout。</span>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-css-container-query');
      if (!root || root.__cqBound) return;
      root.__cqBound = true;

      const resizable = root.querySelector('[data-resizable]');
      const resizer = root.querySelector('[data-resizer]');
      const widthEl = root.querySelector('[data-width]');
      const bpEl = root.querySelector('[data-breakpoint]');

      let dragging = false;
      let startX = 0, startW = 0;

      resizer.addEventListener('pointerdown', e => {
        dragging = true;
        resizer.setPointerCapture(e.pointerId);
        startX = e.clientX;
        startW = resizable.offsetWidth;
        e.preventDefault();
      });
      resizer.addEventListener('pointermove', e => {
        if (!dragging) return;
        const dx = e.clientX - startX;
        const stage = root.querySelector('.stage');
        const maxW = stage.clientWidth - 32; // stage padding margin
        const newW = Math.max(180, Math.min(maxW, startW + dx));
        resizable.style.width = newW + 'px';
      });
      resizer.addEventListener('pointerup',     () => { dragging = false; });
      resizer.addEventListener('pointercancel', () => { dragging = false; });

      // Keyboard:Arrow ±20px
      resizer.addEventListener('keydown', e => {
        const cur = resizable.offsetWidth;
        let next = cur;
        const stage = root.querySelector('.stage');
        const maxW = stage.clientWidth - 32;
        if (e.key === 'ArrowLeft')  next = Math.max(180, cur - 20);
        else if (e.key === 'ArrowRight') next = Math.min(maxW, cur + 20);
        else if (e.key === 'Home')  next = 180;
        else if (e.key === 'End')   next = maxW;
        else return;
        e.preventDefault();
        resizable.style.width = next + 'px';
      });

      // Live readout via ResizeObserver
      const BREAKPOINTS = [
        { min: 480, label: '≥ 480 · 3-col' },
        { min: 320, label: '≥ 320 · 2-col' },
        { min: 0,   label: '< 320 · 1-col' },
      ];
      const ro = new ResizeObserver(entries => {
        for (const entry of entries) {
          const w = Math.round(entry.contentRect.width);
          widthEl.textContent = w;
          const bp = BREAKPOINTS.find(b => w >= b.min);
          bpEl.textContent = bp ? bp.label : '';
          resizer.setAttribute('aria-valuenow', w);
        }
      });
      ro.observe(resizable);
    })();
  </script>
</figure>
