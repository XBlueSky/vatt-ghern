<style>
  .vg-w-demo-mini-canvas-simulation {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-mini-canvas-simulation .toolbar {
    display: flex; flex-wrap: wrap;
    align-items: center; gap: var(--s-2) var(--s-3);
    font-family: var(--sans); font-size: var(--fs-xs);
    color: var(--muted);
  }
  .vg-w-demo-mini-canvas-simulation button {
    font-family: var(--sans); font-size: var(--fs-sm);
    padding: var(--s-2) var(--s-3);
    min-height: 44px;
    background: var(--bg); border: 1px solid var(--line);
    border-radius: 4px;
    color: var(--ink);
    cursor: pointer;
    transition: border-color 150ms, background 150ms;
  }
  .vg-w-demo-mini-canvas-simulation button:hover { border-color: var(--accent); background: var(--bg-soft); }
  .vg-w-demo-mini-canvas-simulation button:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: 2px;
  }
  .vg-w-demo-mini-canvas-simulation .clock {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
    margin-left: auto;
  }
  .vg-w-demo-mini-canvas-simulation canvas {
    width: 100%; height: auto;
    aspect-ratio: 3 / 1;
    display: block;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  @media (max-width: 720px) {
    .vg-w-demo-mini-canvas-simulation canvas { aspect-ratio: 2 / 1; }
  }
  .vg-w-demo-mini-canvas-simulation .readouts {
    display: flex; flex-wrap: wrap;
    gap: var(--s-3);
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); color: var(--muted);
    letter-spacing: 0.04em;
  }
  .vg-w-demo-mini-canvas-simulation .readouts strong {
    font-weight: 600;
    color: var(--accent-text);
    margin-right: 0.3em;
  }
  .vg-w-demo-mini-canvas-simulation figcaption {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-mini-canvas-simulation figcaption code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-mini-canvas-simulation button { transition: none; }
  }
</style>

<figure class="vg-w-demo-mini-canvas-simulation"
        data-fig-question="A queue under steady load: what does ρ=0.88 actually look like over time?"
        data-fig-template="mini-canvas-simulation">
  <div class="toolbar">
    <button data-act="toggle" type="button">pause</button>
    <button data-act="reset" type="button">reset</button>
    <span class="clock" data-clock>t = 0.0s</span>
  </div>

  <canvas data-canvas></canvas>

  <p class="readouts">
    <span><strong>arrived</strong><span data-arrived>0</span></span>
    <span><strong>in queue</strong><span data-queue>0</span></span>
    <span><strong>completed</strong><span data-completed>0</span></span>
    <span><strong>util</strong><span data-util>0%</span></span>
  </p>

  <figcaption>
    M/M/1 single-server queue。<code>λ = 2.2 req/s</code> Poisson 抵達,<code>µ ≈ 2.5 req/s</code> 服務速率 → <code>ρ ≈ 0.88</code>。 在飽和邊緣 queue 會反覆膨脹與消化:這是排隊系統「平均看起來還好、p99 卻很慘」的原因。
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-mini-canvas-simulation');
      if (!root || root.__mcsBound) return;
      root.__mcsBound = true;

      const canvas = root.querySelector('[data-canvas]');
      const btnToggle = root.querySelector('[data-act="toggle"]');
      const btnReset  = root.querySelector('[data-act="reset"]');
      const clockEl = root.querySelector('[data-clock]');
      const arrivedEl = root.querySelector('[data-arrived]');
      const queueEl = root.querySelector('[data-queue]');
      const completedEl = root.querySelector('[data-completed]');
      const utilEl = root.querySelector('[data-util]');

      // ── Color resolution ──
      // Modern canvas accepts oklch() strings; older browsers don't, which
      // silently draws nothing. Paint into a 1×1 helper canvas first so the
      // browser does the colour conversion; we read back RGB which is
      // universally safe to pass to ctx.fillStyle / strokeStyle.
      function resolveColor(varName) {
        const tmp = document.createElement('span');
        tmp.style.color = `var(${varName})`;
        tmp.style.display = 'none';
        document.body.appendChild(tmp);
        const colorStr = getComputedStyle(tmp).color;
        document.body.removeChild(tmp);
        // Convert any browser-returned color (oklch, rgb, lab, etc.) to RGB
        // via a 1×1 paint round-trip.
        const c = document.createElement('canvas');
        c.width = c.height = 1;
        const cx = c.getContext('2d');
        cx.fillStyle = colorStr;
        cx.fillRect(0, 0, 1, 1);
        const d = cx.getImageData(0, 0, 1, 1).data;
        return `rgb(${d[0]} ${d[1]} ${d[2]})`;
      }
      const COLOR = {
        accent: resolveColor('--accent'),
        sage:   resolveColor('--sage-deep'),
        ink:    resolveColor('--ink'),
        muted:  resolveColor('--muted-2'),
        bg:     resolveColor('--bg-soft'),
        line:   resolveColor('--line'),
      };

      // ── Canvas + DPR setup ──
      const ctx = canvas.getContext('2d');
      let W = 0, H = 0, dpr = 1;
      function fitCanvas() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas.getBoundingClientRect();
        W = Math.round(rect.width);
        H = Math.round(rect.height);
        canvas.width  = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      fitCanvas();
      const resizeObserver = new ResizeObserver(fitCanvas);
      resizeObserver.observe(canvas);

      // ── Model ──
      // M/M/1 queue: Poisson arrivals (λ req/s), exponential service (µ req/s).
      // ρ = λ/µ = 0.88 — operating near saturation; queue oscillates visibly.
      const LAMBDA = 2.2;
      const MU     = 2.5;

      let state;
      function resetState() {
        state = {
          tStart: performance.now(),
          tLast: performance.now(),
          simT: 0,                  // simulated seconds
          nextArrival: nextExp(1 / LAMBDA),
          serverBusyUntil: 0,
          inService: null,          // id of task being served
          arrivedCount: 0,
          completedCount: 0,
          queue: [],                // ids waiting
          busyTime: 0,
          // visual: arrival animation dots (flying in from left)
          arrivalDots: [],
          // visual: completed dots (fading at right)
          completedDots: [],
        };
      }
      function nextExp(meanSec) {
        // exponential interarrival / service
        const u = 1 - Math.random();
        return -meanSec * Math.log(u);
      }
      resetState();

      // ── Simulation step ──
      function tick(dtSim) {
        state.simT += dtSim;

        // arrivals
        state.nextArrival -= dtSim;
        while (state.nextArrival <= 0) {
          state.arrivedCount += 1;
          const id = state.arrivedCount;
          state.queue.push(id);
          state.arrivalDots.push({ id, x: 0, vx: 80, born: state.simT });
          state.nextArrival += nextExp(1 / LAMBDA);
        }

        // server
        if (!state.inService && state.queue.length) {
          state.inService = state.queue.shift();
          state.serverBusyUntil = state.simT + nextExp(1 / MU);
        }
        if (state.inService && state.simT >= state.serverBusyUntil) {
          state.completedDots.push({ id: state.inService, x: 0, born: state.simT, life: 1.5 });
          state.completedCount += 1;
          state.inService = null;
        }
        if (state.inService) state.busyTime += dtSim;
      }

      // ── Render ──
      function draw() {
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = COLOR.bg;
        ctx.fillRect(0, 0, W, H);

        // Layout zones (in CSS px space, dpr already applied via setTransform)
        const pad = 14;
        const arrLane = { x: pad, y: pad, w: W * 0.35 - pad * 1.5, h: H - pad * 2 };
        const queueZ  = { x: arrLane.x + arrLane.w + pad, y: pad, w: W * 0.25 - pad, h: H - pad * 2 };
        const serverZ = { x: queueZ.x + queueZ.w + pad, y: pad, w: W * 0.18 - pad, h: H - pad * 2 };
        const compZ   = { x: serverZ.x + serverZ.w + pad, y: pad, w: W - (serverZ.x + serverZ.w + pad * 2), h: H - pad * 2 };

        // ── arrivals lane ──
        ctx.strokeStyle = COLOR.line;
        ctx.lineWidth = 1;
        // baseline arrow
        const aY = arrLane.y + arrLane.h * 0.5;
        ctx.beginPath();
        ctx.moveTo(arrLane.x, aY);
        ctx.lineTo(arrLane.x + arrLane.w, aY);
        ctx.stroke();
        // arrival dots flying right
        state.arrivalDots = state.arrivalDots.filter(d => {
          d.x += d.vx * 0.016;
          const px = arrLane.x + Math.min(d.x, arrLane.w);
          ctx.fillStyle = COLOR.accent;
          ctx.beginPath();
          ctx.arc(px, aY, 3.5, 0, Math.PI * 2);
          ctx.fill();
          return d.x < arrLane.w + 5;
        });

        // ── queue zone (vertical stack) ──
        ctx.strokeStyle = COLOR.muted;
        ctx.strokeRect(queueZ.x + 0.5, queueZ.y + 0.5, queueZ.w - 1, queueZ.h - 1);
        const slotR = 5;
        const slotGap = 4;
        const maxStack = Math.floor((queueZ.h - 12) / (slotR * 2 + slotGap));
        const stackCount = Math.min(state.queue.length, maxStack);
        for (let i = 0; i < stackCount; i++) {
          const cx = queueZ.x + queueZ.w / 2;
          const cy = queueZ.y + queueZ.h - 6 - slotR - i * (slotR * 2 + slotGap);
          ctx.fillStyle = COLOR.accent;
          ctx.beginPath();
          ctx.arc(cx, cy, slotR, 0, Math.PI * 2);
          ctx.fill();
        }
        if (state.queue.length > maxStack) {
          ctx.fillStyle = COLOR.ink;
          ctx.font = 'bold 12px ui-monospace, monospace';
          ctx.textAlign = 'center';
          ctx.fillText('+' + (state.queue.length - maxStack), queueZ.x + queueZ.w / 2, queueZ.y + 14);
        }

        // ── server zone (single circle, fills when busy) ──
        const sX = serverZ.x + serverZ.w / 2;
        const sY = serverZ.y + serverZ.h / 2;
        const sR = Math.min(serverZ.w, serverZ.h) * 0.35;
        ctx.strokeStyle = COLOR.muted;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.arc(sX, sY, sR, 0, Math.PI * 2);
        ctx.stroke();
        if (state.inService) {
          const remain = state.serverBusyUntil - state.simT;
          const total  = remain > 0 ? remain + 0.0001 : 0.0001;
          // simple inner solid circle
          ctx.fillStyle = COLOR.accent;
          ctx.beginPath();
          ctx.arc(sX, sY, sR * 0.7, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.fillStyle = COLOR.bg;
          ctx.beginPath();
          ctx.arc(sX, sY, sR * 0.7, 0, Math.PI * 2);
          ctx.fill();
        }

        // ── completed lane (fade dots flowing right) ──
        state.completedDots = state.completedDots.filter(d => {
          const age = state.simT - d.born;
          if (age > d.life) return false;
          const alpha = 1 - age / d.life;
          const xRatio = Math.min(age / d.life, 1);
          const px = compZ.x + 8 + xRatio * (compZ.w - 16);
          const py = compZ.y + compZ.h / 2;
          ctx.fillStyle = COLOR.sage;
          ctx.globalAlpha = alpha;
          ctx.beginPath();
          ctx.arc(px, py, 3.5, 0, Math.PI * 2);
          ctx.fill();
          ctx.globalAlpha = 1;
          return true;
        });

        // ── labels ──
        ctx.fillStyle = COLOR.muted;
        ctx.font = '10px ui-sans-serif, system-ui, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('arrivals', arrLane.x + arrLane.w / 2, H - 4);
        ctx.fillText('queue',    queueZ.x + queueZ.w / 2, H - 4);
        ctx.fillText('server',   sX, H - 4);
        ctx.fillText('completed', compZ.x + compZ.w / 2, H - 4);
      }

      // ── Loop ──
      let paused = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      btnToggle.textContent = paused ? 'play' : 'pause';
      let raf = null;
      function loop() {
        const now = performance.now();
        const realDt = Math.min(0.05, (now - state.tLast) / 1000);
        state.tLast = now;
        if (!paused) tick(realDt);
        draw();
        // readouts
        clockEl.textContent = 't = ' + state.simT.toFixed(1) + 's';
        arrivedEl.textContent = state.arrivedCount;
        queueEl.textContent = state.queue.length;
        completedEl.textContent = state.completedCount;
        utilEl.textContent = state.simT > 0
          ? Math.round((state.busyTime / state.simT) * 100) + '%'
          : '0%';
        raf = requestAnimationFrame(loop);
      }

      btnToggle.addEventListener('click', () => {
        paused = !paused;
        btnToggle.textContent = paused ? 'play' : 'pause';
        state.tLast = performance.now();
      });
      btnReset.addEventListener('click', () => {
        resetState();
        state.tLast = performance.now();
      });

      loop();
    })();
  </script>
</figure>
