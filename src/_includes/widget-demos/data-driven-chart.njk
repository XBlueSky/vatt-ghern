<style>
  .vg-w-demo-data-driven-chart {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-data-driven-chart .afford {
    display: inline-flex; align-items: center; gap: 0.5em;
    margin: 0 0 var(--s-2);
    font-family: var(--sans); font-size: var(--fs-xs);
    letter-spacing: 0.04em; color: var(--accent-text);
  }
  .vg-w-demo-data-driven-chart .afford > svg { flex-shrink: 0; display: block; width: 13px; height: 13px; }

  /* Type switcher — segmented control, same idiom as branch-toggle */
  .vg-w-demo-data-driven-chart .type-switcher {
    display: inline-flex;
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
    align-self: start;
  }
  .vg-w-demo-data-driven-chart .type-switcher input[type="radio"] {
    position: absolute; opacity: 0; pointer-events: none;
  }
  .vg-w-demo-data-driven-chart .type-switcher label {
    display: inline-flex; align-items: center;
    padding: var(--s-2) var(--s-3);
    font-family: var(--mono); font-size: var(--fs-sm);
    color: var(--ink-soft); background: var(--bg-soft);
    cursor: pointer; border-right: 1px solid var(--line);
    transition: background 150ms, color 150ms;
  }
  .vg-w-demo-data-driven-chart .type-switcher label:last-of-type { border-right: none; }
  .vg-w-demo-data-driven-chart .type-switcher label:hover { background: var(--bg); }
  .vg-w-demo-data-driven-chart:has(#ddc-line:checked) label[for="ddc-line"],
  .vg-w-demo-data-driven-chart:has(#ddc-bar:checked) label[for="ddc-bar"],
  .vg-w-demo-data-driven-chart:has(#ddc-area:checked) label[for="ddc-area"] {
    background: var(--accent); color: var(--bg);
  }
  @media (max-width: 720px) {
    .vg-w-demo-data-driven-chart .type-switcher label { min-height: 44px; }
  }

  /* Legend — sits inline with toggle */
  .vg-w-demo-data-driven-chart .controls {
    display: flex; flex-wrap: wrap;
    align-items: center; gap: var(--s-3);
    margin: 0 0 var(--s-2);
  }
  .vg-w-demo-data-driven-chart .legend {
    display: flex; gap: var(--s-3);
    font-family: var(--sans); font-size: var(--fs-xs);
    color: var(--ink-soft); letter-spacing: 0.04em;
    margin: 0;
  }
  .vg-w-demo-data-driven-chart .legend span { display: inline-flex; align-items: center; gap: 0.4em; }
  .vg-w-demo-data-driven-chart .legend .swatch {
    display: inline-block; width: 1.4em; height: 2px; border-radius: 1px;
  }
  .vg-w-demo-data-driven-chart .legend .sw-p50 { background: var(--sage-deep); }
  .vg-w-demo-data-driven-chart .legend .sw-p99 { background: var(--accent-text); }

  .vg-w-demo-data-driven-chart .chart-wrap {
    position: relative;
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: var(--s-3) var(--s-4) var(--s-4);
    background: var(--bg-soft);
  }
  .vg-w-demo-data-driven-chart svg {
    width: 100%; height: auto; display: block;
  }

  /* Geometry */
  .vg-w-demo-data-driven-chart .axis    { stroke: var(--muted-2); stroke-width: 1; fill: none; }
  .vg-w-demo-data-driven-chart .tickmk  { stroke: var(--muted-2); stroke-width: 1; }
  .vg-w-demo-data-driven-chart .gridln  { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 4; }
  .vg-w-demo-data-driven-chart .line-p50 { stroke: var(--sage-deep); stroke-width: 1.6; fill: none; stroke-linejoin: round; }
  .vg-w-demo-data-driven-chart .line-p99 { stroke: var(--accent-text); stroke-width: 1.6; fill: none; stroke-linejoin: round; }
  .vg-w-demo-data-driven-chart .dot-p50  { fill: var(--bg-soft); stroke: var(--sage-deep);  stroke-width: 1.4; }
  .vg-w-demo-data-driven-chart .dot-p99  { fill: var(--bg-soft); stroke: var(--accent-text); stroke-width: 1.4; }
  .vg-w-demo-data-driven-chart .bar-p50  {
    fill: color-mix(in oklch, var(--sage-deep), transparent 55%);
    stroke: var(--sage-deep); stroke-width: 1;
  }
  .vg-w-demo-data-driven-chart .bar-p99  {
    fill: color-mix(in oklch, var(--accent-text), transparent 60%);
    stroke: var(--accent-text); stroke-width: 1;
  }
  .vg-w-demo-data-driven-chart .area-p99 {
    fill: color-mix(in oklch, var(--accent-text), transparent 82%);
    stroke: var(--accent-text); stroke-width: 1.4; stroke-linejoin: round;
  }
  .vg-w-demo-data-driven-chart .annot-line { stroke: var(--accent); stroke-width: 1; stroke-dasharray: 3 3; fill: none; }

  /* HTML overlay layer for typography */
  .vg-w-demo-data-driven-chart .overlay {
    position: absolute;
    inset: var(--s-3) var(--s-4) var(--s-4);
    pointer-events: none;
  }
  /* DIRECT child only — descendant selector caught .tick-x-prefix and turned
     it into a block-level absolute, peeling "DSM " out of its tick container
     and overlapping it onto adjacent labels. */
  .vg-w-demo-data-driven-chart .overlay > span {
    position: absolute; line-height: 1;
  }
  .vg-w-demo-data-driven-chart .tick-y, .vg-w-demo-data-driven-chart .tick-x {
    /* sans (Manrope) over mono — at axis-tick scale mono fonts are easier
       to fall back to CJK kaishu (LXGW) which mangles digits; sans loads
       reliably and stays legible. tabular-nums keeps the digits aligned. */
    font-family: var(--sans);
    font-variant-numeric: tabular-nums;
    font-feature-settings: "tnum"; /* reset any inherited kern/liga/calt */
    font-size: var(--fs-xs);
    color: var(--muted);
  }
  .vg-w-demo-data-driven-chart .tick-y { transform: translate(-100%, -50%); padding-right: 0.4em; }
  .vg-w-demo-data-driven-chart .tick-x { transform: translate(-50%, 0); padding-top: 0.3em; white-space: nowrap; }
  @media (max-width: 720px) {
    .vg-w-demo-data-driven-chart .tick-x-prefix { display: none; }
  }
  .vg-w-demo-data-driven-chart .annot {
    font-family: var(--scribed);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--accent-text);
    transform: translate(0, -100%);
    padding-bottom: 0.3em;
    max-width: 11em;
  }

  /* serif italic (Spectral),not --scribed —— DESIGN.md 明確說
     「不要把長段技術 prose 放進 --scribed,modern Latin terms 像
     `HTTP`/`Ed25519`/`IPC` 在古籍字體下會讀起來破碎」。 */
  .vg-w-demo-data-driven-chart figcaption {
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--ink-soft);
    line-height: 1.55;
    margin: 0;
  }
  .vg-w-demo-data-driven-chart figcaption code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-data-driven-chart .type-switcher label { transition: none; }
  }
</style>

<figure class="vg-w-demo-data-driven-chart"
        data-fig-question="Where did the dlopen p99 actually drop, and what landed at that release?"
        data-fig-template="data-driven-chart">
  <p class="afford">
    <svg viewBox="0 0 24 24" width="13" height="13" fill="none"
         stroke="currentColor" stroke-width="1.8"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 9 5 12 1.8-5.2L21 14Z"/>
      <path d="M7.2 2.2 8 5.1"/><path d="m5.1 8-2.9-.8"/>
      <path d="M14 4.1 12 6"/><path d="m6 12-1.9 2"/>
    </svg>
    <span>切換圖表型態 · 同一份資料、不同視覺呈現</span>
  </p>

  <div class="controls">
    <div class="type-switcher" role="tablist">
      <input type="radio" id="ddc-line" name="ddc-type" value="line" checked />
      <label for="ddc-line" role="tab">line</label>
      <input type="radio" id="ddc-bar"  name="ddc-type" value="bar" />
      <label for="ddc-bar" role="tab">bar</label>
      <input type="radio" id="ddc-area" name="ddc-type" value="area" />
      <label for="ddc-area" role="tab">area</label>
    </div>
    <p class="legend">
      <span><span class="swatch sw-p50"></span>p50</span>
      <span><span class="swatch sw-p99"></span>p99</span>
    </p>
  </div>

  <div class="chart-wrap">
    <svg viewBox="0 0 720 280" preserveAspectRatio="xMidYMid meet" role="img"
         aria-label="scgi runner dlopen latency: p50 and p99 across DSM 7.2 – 7.7"></svg>
    <div class="overlay" data-overlay></div>
  </div>
  <figcaption>
    source: scgi runner <code>dlopen</code> p50 / p99 latency,DS923+,2026-04 / 60s @ 1000 concurrent;n ≈ 10k per release。<code>m_mapHandle</code> 在 DSM 7.6 落地。
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-data-driven-chart');
      if (!root || root.__ddcBound) return;
      root.__ddcBound = true;

      // .chart-wrap svg specifically — the figure also contains the
       // affordance icon SVG; selecting bare "svg" would draw the chart
       // into the 13×13 icon and clip everything.
      const svg = root.querySelector('.chart-wrap svg');
      const overlay = root.querySelector('[data-overlay]');
      const NS = 'http://www.w3.org/2000/svg';

      const data = [
        { release: '7.2', p50: 12.4, p99: 87.0 },
        { release: '7.3', p50: 11.9, p99: 82.1 },
        { release: '7.4', p50: 11.5, p99: 78.8 },
        { release: '7.5', p50: 11.2, p99: 74.5 },
        { release: '7.6', p50: 10.9, p99: 41.2 },
        { release: '7.7', p50: 10.7, p99: 23.4 },
      ];

      const VB_W = 720, VB_H = 280;
      const PAD_L = 60, PAD_R = 24, PAD_T = 24, PAD_B = 40;
      const X0 = PAD_L, X1 = VB_W - PAD_R;
      const Y0 = VB_H - PAD_B, Y1 = PAD_T;

      const yTicks = [0, 25, 50, 75, 100];
      const maxY = yTicks[yTicks.length - 1];
      const yOf = v => Y0 - (v / maxY) * (Y0 - Y1);
      const xOf = i => X0 + (i + 0.5) * (X1 - X0) / data.length;

      function el(tag, attrs) {
        const e = document.createElementNS(NS, tag);
        for (const [k, v] of Object.entries(attrs)) e.setAttribute(k, v);
        return e;
      }
      function pct(value, total) { return (value / total * 100).toFixed(2) + '%'; }

      // ── Static layer: axes + ticks + tick labels (rendered once) ──
      function renderStatic() {
        // gridlines + y-axis tick marks
        const g = el('g', { 'data-static': '' });
        yTicks.forEach(t => {
          const y = yOf(t);
          g.appendChild(el('line', { class: 'gridln', x1: X0, y1: y, x2: X1, y2: y }));
          g.appendChild(el('line', { class: 'tickmk', x1: X0 - 4, y1: y, x2: X0, y2: y }));
          const span = document.createElement('span');
          span.className = 'tick-y';
          span.textContent = t;
          span.style.left = pct(X0, VB_W);
          span.style.top  = pct(y,  VB_H);
          overlay.appendChild(span);
        });
        // axis lines
        g.appendChild(el('line', { class: 'axis', x1: X0, y1: Y0, x2: X1, y2: Y0 }));
        g.appendChild(el('line', { class: 'axis', x1: X0, y1: Y0, x2: X0, y2: Y1 }));
        // x-axis tick marks + labels
        data.forEach((d, i) => {
          const x = xOf(i);
          g.appendChild(el('line', { class: 'tickmk', x1: x, y1: Y0, x2: x, y2: Y0 + 4 }));
          const span = document.createElement('span');
          span.className = 'tick-x';
          const prefix = document.createElement('span');
          prefix.className = 'tick-x-prefix';
          prefix.textContent = 'DSM ';
          span.appendChild(prefix);
          span.appendChild(document.createTextNode(d.release));
          span.style.left = pct(x,  VB_W);
          span.style.top  = pct(Y0, VB_H);
          overlay.appendChild(span);
        });
        svg.appendChild(g);
      }

      // ── Data marks (cleared + re-rendered on type switch) ──
      function clearDataMarks() {
        svg.querySelectorAll('[data-mark]').forEach(el => el.remove());
        overlay.querySelectorAll('.annot, .annot-anchor').forEach(el => el.remove());
      }

      function pathFor(key) {
        return data.map((d, i) => (i ? 'L' : 'M') + xOf(i) + ',' + yOf(d[key])).join(' ');
      }

      function renderLine() {
        const g = el('g', { 'data-mark': 'line' });
        g.appendChild(el('path', { class: 'line-p50', d: pathFor('p50') }));
        g.appendChild(el('path', { class: 'line-p99', d: pathFor('p99') }));
        data.forEach((d, i) => {
          g.appendChild(el('circle', { class: 'dot-p50', cx: xOf(i), cy: yOf(d.p50), r: 3.2 }));
          g.appendChild(el('circle', { class: 'dot-p99', cx: xOf(i), cy: yOf(d.p99), r: 3.2 }));
        });
        svg.appendChild(g);
      }

      function renderBar() {
        const g = el('g', { 'data-mark': 'bar' });
        const groupW = (X1 - X0) / data.length;
        const barW = groupW * 0.32;
        data.forEach((d, i) => {
          const cx = xOf(i);
          g.appendChild(el('rect', {
            class: 'bar-p50',
            x: cx - barW - 1, y: yOf(d.p50),
            width: barW, height: Y0 - yOf(d.p50),
          }));
          g.appendChild(el('rect', {
            class: 'bar-p99',
            x: cx + 1, y: yOf(d.p99),
            width: barW, height: Y0 - yOf(d.p99),
          }));
        });
        svg.appendChild(g);
      }

      function renderArea() {
        const g = el('g', { 'data-mark': 'area' });
        // p99 filled area
        const areaPath = pathFor('p99')
          + ' L' + xOf(data.length - 1) + ',' + Y0
          + ' L' + xOf(0) + ',' + Y0 + ' Z';
        g.appendChild(el('path', { class: 'area-p99', d: areaPath }));
        // p50 line layered on top
        g.appendChild(el('path', { class: 'line-p50', d: pathFor('p50') }));
        data.forEach((d, i) => {
          g.appendChild(el('circle', { class: 'dot-p50', cx: xOf(i), cy: yOf(d.p50), r: 2.6 }));
        });
        svg.appendChild(g);
      }

      function renderAnnotation() {
        const ai = 4;
        const ax = xOf(ai);
        const ay = yOf(data[ai].p99);
        const anchor = el('line', {
          'data-mark': 'annot',
          class: 'annot-line',
          x1: ax, y1: ay - 6, x2: ax, y2: ay - 50,
        });
        svg.appendChild(anchor);
        const annot = document.createElement('span');
        annot.className = 'annot';
        annot.textContent = 'handle cache 在這版落地';
        annot.style.left = pct(ax + 4, VB_W);
        annot.style.top  = pct(ay - 50, VB_H);
        overlay.appendChild(annot);
      }

      function render(type) {
        clearDataMarks();
        if (type === 'line') renderLine();
        else if (type === 'bar') renderBar();
        else if (type === 'area') renderArea();
        renderAnnotation();
      }

      // ── Bind ──
      renderStatic();
      const initial = root.querySelector('input[name="ddc-type"]:checked')?.value || 'line';
      render(initial);
      root.querySelectorAll('input[name="ddc-type"]').forEach(input => {
        input.addEventListener('change', (e) => render(e.target.value));
      });
    })();
  </script>
</figure>
