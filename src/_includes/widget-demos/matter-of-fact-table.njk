<style>
  .vg-w-demo-matter-of-fact-table {
    margin: var(--s-3) 0 var(--s-4);
    display: grid; gap: var(--s-2);
  }
  .vg-w-demo-matter-of-fact-table .table-wrap {
    overflow-x: auto;
  }
  .vg-w-demo-matter-of-fact-table table {
    width: 100%; min-width: 460px;
    border-collapse: collapse;
    font-family: var(--serif); font-size: var(--fs-sm);
  }
  .vg-w-demo-matter-of-fact-table th, .vg-w-demo-matter-of-fact-table td {
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--line);
    text-align: left; vertical-align: baseline;
  }
  /* header:不加 bg,改用較深 border-bottom 做 typographic underline,
     row hover bg 就可以獨佔 --bg-soft,不會跟 header bg 黏在一起 */
  .vg-w-demo-matter-of-fact-table thead th {
    font-family: var(--sans); font-size: var(--fs-xs);
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted); font-weight: 600;
    cursor: pointer; user-select: none;
    border-bottom: 1.5px solid var(--ink-soft);
    transition: color 120ms;
  }
  .vg-w-demo-matter-of-fact-table thead th:hover { color: var(--accent-text); }
  .vg-w-demo-matter-of-fact-table thead th:focus-visible {
    outline: 2px solid var(--accent-text);
    outline-offset: -2px;
  }
  .vg-w-demo-matter-of-fact-table thead th .label {
    display: inline-flex; align-items: center; gap: 0.4em;
  }
  /* sort icon SVG —— 預設 chevron-up-down,active 時切 chevron-up 或 chevron-down。
     14px 在 fs-xs 字面上的視覺平衡好讀。 */
  .vg-w-demo-matter-of-fact-table thead th .sort-ico {
    width: 14px; height: 14px;
    flex-shrink: 0;
    color: var(--muted-2);
  }
  .vg-w-demo-matter-of-fact-table thead th .sort-ico path { stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; fill: none; }
  .vg-w-demo-matter-of-fact-table thead th[aria-sort="ascending"]  .sort-ico,
  .vg-w-demo-matter-of-fact-table thead th[aria-sort="descending"] .sort-ico { color: var(--accent-text); }
  .vg-w-demo-matter-of-fact-table thead th .ico-both,
  .vg-w-demo-matter-of-fact-table thead th .ico-up,
  .vg-w-demo-matter-of-fact-table thead th .ico-down { display: none; }
  .vg-w-demo-matter-of-fact-table thead th:not([aria-sort]) .ico-both { display: inline; }
  .vg-w-demo-matter-of-fact-table thead th[aria-sort="ascending"]  .ico-up { display: inline; }
  .vg-w-demo-matter-of-fact-table thead th[aria-sort="descending"] .ico-down { display: inline; }

  .vg-w-demo-matter-of-fact-table tbody tr {
    transition: background 100ms;
  }
  .vg-w-demo-matter-of-fact-table tbody tr:hover { background: var(--bg-soft); }
  .vg-w-demo-matter-of-fact-table tbody tr:last-child td { border-bottom: none; }
  .vg-w-demo-matter-of-fact-table tbody td.num {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    text-align: right; color: var(--ink);
  }
  .vg-w-demo-matter-of-fact-table tbody td .system-name {
    font-family: var(--mono); font-weight: 600; color: var(--ink);
  }

  .vg-w-demo-matter-of-fact-table figcaption {
    margin: 0;
    display: grid; gap: 0.2em;
  }
  .vg-w-demo-matter-of-fact-table figcaption .source {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-matter-of-fact-table figcaption .source code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-matter-of-fact-table figcaption .hint {
    font-family: var(--sans); font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
    margin: 0;
  }
  .vg-w-demo-matter-of-fact-table figcaption .hint kbd {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg-soft);
    padding: 0.05em 0.32em;
    border: 1px solid var(--line);
    border-radius: 3px;
    color: var(--ink-soft);
  }
</style>

<figure class="vg-w-demo-matter-of-fact-table">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th data-sort="text" tabindex="0">
            <span class="label">system{% include 'partials/_sort-icons.njk' ignore missing %}<svg class="sort-ico ico-both" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg><svg class="sort-ico ico-up" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 7-7 7 7"/></svg><svg class="sort-ico ico-down" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7"/></svg></span>
          </th>
          <th data-sort="num" tabindex="0">
            <span class="label">p50 (ms)<svg class="sort-ico ico-both" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg><svg class="sort-ico ico-up" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 7-7 7 7"/></svg><svg class="sort-ico ico-down" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7"/></svg></span>
          </th>
          <th data-sort="num" tabindex="0">
            <span class="label">p99 (ms)<svg class="sort-ico ico-both" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg><svg class="sort-ico ico-up" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 7-7 7 7"/></svg><svg class="sort-ico ico-down" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7"/></svg></span>
          </th>
          <th data-sort="num" tabindex="0">
            <span class="label">RSS (MB)<svg class="sort-ico ico-both" viewBox="0 0 24 24" aria-hidden="true"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg><svg class="sort-ico ico-up" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 15 7-7 7 7"/></svg><svg class="sort-ico ico-down" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 9 7 7 7-7"/></svg></span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr><td><span class="system-name">morpheus</span></td><td class="num">2.1</td><td class="num">8.4</td><td class="num">62</td></tr>
        <tr><td><span class="system-name">synoscgi</span></td><td class="num">5.6</td><td class="num">21.0</td><td class="num">148</td></tr>
        <tr><td><span class="system-name">nginx-direct</span></td><td class="num">0.9</td><td class="num">3.2</td><td class="num">28</td></tr>
        <tr><td><span class="system-name">synoapid</span></td><td class="num">3.8</td><td class="num">14.6</td><td class="num">96</td></tr>
      </tbody>
    </table>
  </div>
  <figcaption>
    <p class="source">source: webapi entry latency · DS923+ · 2026-04 · 60s @ 200 concurrent · n ≈ 12k / system。</p>
    <p class="hint">點 column header,或 Tab 過去按 <kbd>Enter</kbd> / <kbd>Space</kbd> 排序。</p>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-matter-of-fact-table');
      if (!root || root.__mofBound) return;
      root.__mofBound = true;

      const ths = root.querySelectorAll('thead th');
      const tbody = root.querySelector('tbody');

      function sortBy(i, dir) {
        ths.forEach(t => t.removeAttribute('aria-sort'));
        ths[i].setAttribute('aria-sort', dir);
        const isNum = ths[i].dataset.sort === 'num';
        const rows = Array.from(tbody.querySelectorAll('tr'));
        rows.sort((a, b) => {
          const av = a.children[i].textContent.trim();
          const bv = b.children[i].textContent.trim();
          const cmp = isNum ? parseFloat(av) - parseFloat(bv) : av.localeCompare(bv);
          return dir === 'ascending' ? cmp : -cmp;
        });
        rows.forEach(r => tbody.appendChild(r));
      }

      function activate(th, i) {
        const cur = th.getAttribute('aria-sort');
        const dir = cur === 'ascending' ? 'descending' : 'ascending';
        sortBy(i, dir);
      }

      ths.forEach((th, i) => {
        th.addEventListener('click', () => activate(th, i));
        th.addEventListener('keydown', e => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activate(th, i);
          }
        });
      });
    })();
  </script>
</figure>
