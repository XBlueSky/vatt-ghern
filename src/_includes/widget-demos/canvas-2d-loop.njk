<style>
  .vg-w-demo-canvas-2d-loop {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-2);
    margin: var(--s-3) 0 var(--s-4);
  }
  /* Header 在 chart 上方一行,不 overlay —— sparkline 滿格時不會撞到字 */
  .vg-w-demo-canvas-2d-loop .header {
    display: flex; justify-content: space-between;
    align-items: baseline;
    padding: 0 0.2rem;
  }
  .vg-w-demo-canvas-2d-loop .header .name {
    font-family: var(--sans); font-size: var(--fs-xs);
    letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--muted);
  }
  .vg-w-demo-canvas-2d-loop .header .value {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-sm); color: var(--accent-text);
    font-weight: 600;
  }
  .vg-w-demo-canvas-2d-loop .chart-wrap {
    width: 100%;
    max-width: 600px;
    aspect-ratio: 5 / 1;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
  }
  .vg-w-demo-canvas-2d-loop canvas {
    width: 100%; height: 100%; display: block;
  }
  .vg-w-demo-canvas-2d-loop figcaption {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-canvas-2d-loop figcaption code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
</style>

<figure class="vg-w-demo-canvas-2d-loop">
  <div class="header">
    <span class="name">cpu · % busy</span>
    <span class="value" data-value>—</span>
  </div>
  <div class="chart-wrap">
    <canvas data-canvas></canvas>
  </div>
  <figcaption>
    模擬一張 ~60s 視窗的 CPU 監控,每 ~100ms 推一筆新值進 ring buffer 並把舊值往左推。
    虛線標 <code>80%</code> 警戒。<code>requestAnimationFrame</code> 驅動 rAF loop,
    時間 throttle 用累積 dt 處理而非每 frame 都 sample。
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-canvas-2d-loop');
      if (!root || root.__c2lBound) return;
      root.__c2lBound = true;

      const canvas = root.querySelector('[data-canvas]');
      const valueEl = root.querySelector('[data-value]');
      const ctx = canvas.getContext('2d');

      // ── Color resolution(canvas-safe RGB,跟 mini-canvas-simulation 同 pattern) ──
      function resolveColor(varName) {
        const tmp = document.createElement('span');
        tmp.style.color = `var(${varName})`;
        tmp.style.display = 'none';
        document.body.appendChild(tmp);
        const colorStr = getComputedStyle(tmp).color;
        document.body.removeChild(tmp);
        const c = document.createElement('canvas');
        c.width = c.height = 1;
        const cx = c.getContext('2d');
        cx.fillStyle = colorStr;
        cx.fillRect(0, 0, 1, 1);
        const d = cx.getImageData(0, 0, 1, 1).data;
        return `rgb(${d[0]} ${d[1]} ${d[2]})`;
      }
      // helper:把 RGB 跟 alpha 組成 canvas-safe rgba 字串
      function withAlpha(rgb, a) {
        const m = rgb.match(/rgb\((\d+)\s+(\d+)\s+(\d+)\)/);
        if (!m) return rgb;
        return `rgba(${m[1]}, ${m[2]}, ${m[3]}, ${a})`;
      }
      const COLOR = {
        accent: resolveColor('--accent'),
        muted:  resolveColor('--muted-2'),
        line:   resolveColor('--line'),
        bg:     resolveColor('--bg-soft'),
      };
      const ACCENT_FILL = withAlpha(COLOR.accent, 0.16);

      // ── Canvas DPR ──
      let W = 0, H = 0;
      function fitCanvas() {
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        const rect = canvas.getBoundingClientRect();
        W = Math.round(rect.width);
        H = Math.round(rect.height);
        canvas.width  = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
      fitCanvas();
      new ResizeObserver(fitCanvas).observe(canvas);

      // ── Model:random walk with occasional Poisson-style spikes ──
      const SAMPLE_INTERVAL_MS = 100;
      const MAX_SAMPLES = 240; // 24s of history at 100ms/sample
      const THRESHOLD = 80;

      const samples = [];
      let lastV = 45;
      function nextValue() {
        // brownian step
        let v = lastV + (Math.random() - 0.5) * 8;
        // ~3% chance of a Poisson-style spike
        if (Math.random() < 0.03) v += 25 + Math.random() * 20;
        // gentle pull toward 45 to keep value bounded
        v += (45 - v) * 0.02;
        v = Math.max(5, Math.min(98, v));
        lastV = v;
        return v;
      }

      // seed with a partial history so the first frame doesn't look empty
      for (let i = 0; i < MAX_SAMPLES * 0.4; i++) samples.push(nextValue());

      // ── Render ──
      function yOf(v) {
        const pad = 14;
        return pad + (1 - v / 100) * (H - pad * 2);
      }

      function draw() {
        ctx.clearRect(0, 0, W, H);

        // threshold dashed
        ctx.setLineDash([4, 4]);
        ctx.strokeStyle = COLOR.muted;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(0, yOf(THRESHOLD));
        ctx.lineTo(W, yOf(THRESHOLD));
        ctx.stroke();
        ctx.setLineDash([]);

        // sparkline area fill
        const stepX = W / (MAX_SAMPLES - 1);
        ctx.beginPath();
        ctx.moveTo(0, H);
        for (let i = 0; i < samples.length; i++) {
          const x = i * stepX;
          ctx.lineTo(x, yOf(samples[i]));
        }
        const lastX = (samples.length - 1) * stepX;
        ctx.lineTo(lastX, H);
        ctx.closePath();
        ctx.fillStyle = ACCENT_FILL;
        ctx.fill();

        // sparkline stroke
        ctx.strokeStyle = COLOR.accent;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        for (let i = 0; i < samples.length; i++) {
          const x = i * stepX;
          const y = yOf(samples[i]);
          if (i === 0) ctx.moveTo(x, y); else ctx.lineTo(x, y);
        }
        ctx.stroke();

        // current value marker dot
        if (samples.length) {
          const x = (samples.length - 1) * stepX;
          const y = yOf(samples[samples.length - 1]);
          ctx.fillStyle = COLOR.bg;
          ctx.strokeStyle = COLOR.accent;
          ctx.lineWidth = 1.6;
          ctx.beginPath();
          ctx.arc(x, y, 3.2, 0, Math.PI * 2);
          ctx.fill();
          ctx.stroke();
        }

        // current value text label
        const cur = samples[samples.length - 1] || 0;
        valueEl.textContent = cur.toFixed(0) + ' %';
      }

      // ── rAF loop with dt accumulator(時間 throttle —— sample 不跟著
      //    rAF 速率走,固定 100ms 一筆,frame rate 高也不會多塞值) ──
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lastTs = performance.now();
      let acc = 0;
      function loop(now) {
        const dt = now - lastTs;
        lastTs = now;
        acc += dt;
        while (acc >= SAMPLE_INTERVAL_MS) {
          samples.push(nextValue());
          if (samples.length > MAX_SAMPLES) samples.shift();
          acc -= SAMPLE_INTERVAL_MS;
        }
        draw();
        if (!reduced) requestAnimationFrame(loop);
      }
      requestAnimationFrame(loop);
    })();
  </script>
</figure>
