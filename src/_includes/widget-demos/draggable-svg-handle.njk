<style>
  .vg-w-demo-draggable-svg-handle {
    display: grid; gap: var(--s-2);
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-draggable-svg-handle svg {
    width: 100%; height: auto; display: block;
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 6px;
    touch-action: none;
  }
  .vg-w-demo-draggable-svg-handle .track-bg   { stroke: var(--muted-2); stroke-width: 4; stroke-linecap: round; }
  .vg-w-demo-draggable-svg-handle .track-fill { stroke: var(--accent);  stroke-width: 4; stroke-linecap: round; }
  .vg-w-demo-draggable-svg-handle .tick       { stroke: var(--muted-2); stroke-width: 1; }
  .vg-w-demo-draggable-svg-handle .handle     { fill: var(--accent); stroke: var(--bg); stroke-width: 3; cursor: grab; }
  .vg-w-demo-draggable-svg-handle .handle:active { cursor: grabbing; }
  /* hit area:長 rect 覆蓋整條 track —— 點任一位置都能 grab,行動端
     觸控 72px 高遠超 44 基準 */
  .vg-w-demo-draggable-svg-handle .track-hit {
    cursor: grab;
    touch-action: none;
  }
  .vg-w-demo-draggable-svg-handle .track-hit:active { cursor: grabbing; }
  .vg-w-demo-draggable-svg-handle .handle:focus { outline: none; }
  .vg-w-demo-draggable-svg-handle .handle:focus-visible {
    outline: none;
    stroke: var(--accent-text); stroke-width: 4;
    stroke-dasharray: 4 3;
  }

  .vg-w-demo-draggable-svg-handle .readout {
    display: flex; flex-wrap: wrap;
    justify-content: space-between; align-items: baseline;
    gap: var(--s-2) var(--s-4);
    padding: 0 0.2rem;
    margin: 0;
  }
  .vg-w-demo-draggable-svg-handle .readout .pct {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-md);
    color: var(--accent-text); font-weight: 600;
    letter-spacing: 0.02em;
  }
  .vg-w-demo-draggable-svg-handle .readout .pct .unit {
    font-size: 0.62em;
    color: var(--muted); letter-spacing: 0.06em;
    font-weight: 400;
    text-transform: uppercase;
    margin-left: 0.7em;
  }
  .vg-w-demo-draggable-svg-handle .readout .aux {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); color: var(--muted);
    letter-spacing: 0.04em;
  }
  .vg-w-demo-draggable-svg-handle .readout .aux strong {
    color: var(--ink); font-weight: 600;
  }
  .vg-w-demo-draggable-svg-handle figcaption {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.6; margin: 0;
  }
  .vg-w-demo-draggable-svg-handle figcaption code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-draggable-svg-handle figcaption ol {
    margin: var(--s-2) 0 0; padding: 0;
    list-style: none; counter-reset: rule;
    display: grid; gap: 0.3em;
  }
  .vg-w-demo-draggable-svg-handle figcaption ol li {
    position: relative;
    padding-left: 2em;
    font-style: normal; color: var(--ink);
  }
  .vg-w-demo-draggable-svg-handle figcaption ol li::before {
    counter-increment: rule;
    content: counter(rule) '.';
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--accent-text); letter-spacing: 0.04em;
  }
</style>

<figure class="vg-w-demo-draggable-svg-handle">
  <svg viewBox="0 0 600 100" role="img"
       aria-label="rollout percent slider, dragging the handle adjusts the rollout">
    <!-- track -->
    <line class="track-bg" x1="40" y1="50" x2="560" y2="50" />
    <line class="track-fill" data-fill x1="40" y1="50" x2="170" y2="50" />
    <!-- ticks at 0 / 25 / 50 / 75 / 100 -->
    <line class="tick" x1="40"  y1="42" x2="40"  y2="58" />
    <line class="tick" x1="170" y1="44" x2="170" y2="56" />
    <line class="tick" x1="300" y1="42" x2="300" y2="58" />
    <line class="tick" x1="430" y1="44" x2="430" y2="56" />
    <line class="tick" x1="560" y1="42" x2="560" y2="58" />
    <!-- hit area:長 rect 覆蓋整條 track —— 點任何位置都能啟動 drag。
         height 88(viewBox)在 50% scale 的 375px 下 = 44 screen,過 mobile tap 基準 -->
    <rect class="track-hit" data-hit x="20" y="4" width="560" height="92"
          fill="transparent" cursor="grab" />
    <!-- 視覺 handle cap(只負責顯示 + 鍵盤 focus) -->
    <circle class="handle" data-handle cx="170" cy="50" r="10"
            tabindex="0" role="slider"
            aria-label="rollout percent"
            aria-valuemin="0" aria-valuemax="100" aria-valuenow="25"
            pointer-events="none" />
  </svg>
  <p class="readout">
    <span class="pct"><span data-pct>25</span> %<span class="unit">rollout</span></span>
    <span class="aux">適用 <strong data-users>2,500</strong> / 10,000 users</span>
  </p>
  <figcaption>
    SVG 內拖把手的三件事:
    <ol>
      <li>用 <code>createSVGPoint()</code> + <code>getScreenCTM().inverse()</code> 把 <code>e.clientX</code> 轉回 viewBox 座標 —— 不轉,cx 跟指標對不上。</li>
      <li>整條 track 都是 hit area(透明 <code>&lt;rect&gt;</code> 覆蓋全長)—— 點任何位置 handle 都能 snap 過去,跟原生 range slider 同 UX。</li>
      <li>視覺 handle 給 <code>pointer-events: none</code> —— 它只負責 *顯示* 跟 *鍵盤 focus*,pointer events 由 hit-rect 接管。</li>
    </ol>
  </figcaption>

  <script>
    (function () {
      const root = document.currentScript.closest('.vg-w-demo-draggable-svg-handle');
      if (!root || root.__dshBound) return;
      root.__dshBound = true;

      const svg = root.querySelector('svg');
      const hit = root.querySelector('[data-hit]');
      const handle = root.querySelector('[data-handle]');
      const fill = root.querySelector('[data-fill]');
      const pctEl = root.querySelector('[data-pct]');
      const usersEl = root.querySelector('[data-users]');

      const X0 = 40, X1 = 560;
      const TOTAL_USERS = 10000;

      function setX(x) {
        x = Math.max(X0, Math.min(X1, x));
        handle.setAttribute('cx', x);
        fill.setAttribute('x2', x);
        const pct = Math.round(((x - X0) / (X1 - X0)) * 100);
        pctEl.textContent = pct;
        usersEl.textContent = (Math.round(pct / 100 * TOTAL_USERS)).toLocaleString();
        handle.setAttribute('aria-valuenow', pct);
      }

      // svg createSVGPoint:把 e.clientX/Y 轉到 viewBox 座標
      function svgPt(e) {
        const pt = svg.createSVGPoint();
        pt.x = e.clientX; pt.y = e.clientY;
        return pt.matrixTransform(svg.getScreenCTM().inverse());
      }

      // 整條 track 都是 hit area;點下去 handle 立刻 snap 過去、再依
      // pointer 跟著移動。原生 <input type="range"> 就是這個 UX。
      let dragging = false;
      hit.addEventListener('pointerdown', e => {
        dragging = true;
        hit.setPointerCapture(e.pointerId);
        setX(svgPt(e).x);
        e.preventDefault();
      });
      hit.addEventListener('pointermove', e => {
        if (dragging) setX(svgPt(e).x);
      });
      hit.addEventListener('pointerup',     () => { dragging = false; });
      hit.addEventListener('pointercancel', () => { dragging = false; });

      // Keyboard:Arrow ±2、Home/End jump 0/100
      handle.addEventListener('keydown', e => {
        const cur = parseFloat(handle.getAttribute('cx'));
        const STEP = (X1 - X0) * 0.02; // 2%/key
        let next = cur;
        if (e.key === 'ArrowLeft')  next = cur - STEP;
        else if (e.key === 'ArrowRight') next = cur + STEP;
        else if (e.key === 'Home')  next = X0;
        else if (e.key === 'End')   next = X1;
        else return;
        e.preventDefault();
        setX(next);
      });
    })();
  </script>
</figure>
