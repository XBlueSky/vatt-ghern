<style>
  .vg-w-demo-timeline-scrubber {
    display: grid; gap: var(--s-3);
    margin: var(--s-3) 0 var(--s-4);
  }
  .vg-w-demo-timeline-scrubber input[type="radio"] {
    position: absolute; opacity: 0; pointer-events: none;
  }

  /* Track:5 step 平均分布,後面一條 hairline 串起,前景一條 accent fill 隨選中位置長 */
  .vg-w-demo-timeline-scrubber .track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    padding: var(--s-1) 0 var(--s-2);
  }
  .vg-w-demo-timeline-scrubber .track::before,
  .vg-w-demo-timeline-scrubber .track::after {
    content: "";
    position: absolute;
    top: calc(var(--s-1) + 8px);
    height: 1.5px;
    pointer-events: none;
  }
  .vg-w-demo-timeline-scrubber .track::before {
    left: 10%; right: 10%;
    background: var(--muted-2);
  }
  .vg-w-demo-timeline-scrubber .track::after {
    left: 10%;
    width: 0%;
    background: var(--accent);
    transition: width 240ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .vg-w-demo-timeline-scrubber:has(#ts-1:checked) .track::after { width: 0%; }
  .vg-w-demo-timeline-scrubber:has(#ts-2:checked) .track::after { width: 20%; }
  .vg-w-demo-timeline-scrubber:has(#ts-3:checked) .track::after { width: 40%; }
  .vg-w-demo-timeline-scrubber:has(#ts-4:checked) .track::after { width: 60%; }
  .vg-w-demo-timeline-scrubber:has(#ts-5:checked) .track::after { width: 80%; }

  .vg-w-demo-timeline-scrubber .step {
    display: grid;
    grid-template-rows: 18px auto auto;
    justify-items: center; align-items: start;
    gap: 0.15em;
    padding: 0 var(--s-1);
    min-height: 64px; /* 44 tap target + 額外文字 */
    cursor: pointer;
    position: relative; z-index: 1;
  }
  .vg-w-demo-timeline-scrubber .step .dot {
    width: 11px; height: 11px; margin-top: 4px;
    border: 1.5px solid var(--muted-2);
    border-radius: 50%;
    background: var(--bg);
    transition: background 200ms, border-color 200ms;
  }
  .vg-w-demo-timeline-scrubber .step .ts {
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
    transition: color 200ms;
  }
  .vg-w-demo-timeline-scrubber .step .phase {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-xs);
    color: var(--muted-2);
    text-align: center; line-height: 1.25;
    transition: color 200ms;
  }

  /* Active step:dot 填色、ts + phase 上色 */
  .vg-w-demo-timeline-scrubber:has(#ts-1:checked) [for="ts-1"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-2:checked) [for="ts-2"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-3:checked) [for="ts-3"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-4:checked) [for="ts-4"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-5:checked) [for="ts-5"] .dot {
    background: var(--accent);
    border-color: var(--accent);
  }
  .vg-w-demo-timeline-scrubber:has(#ts-1:checked) [for="ts-1"] .ts,
  .vg-w-demo-timeline-scrubber:has(#ts-2:checked) [for="ts-2"] .ts,
  .vg-w-demo-timeline-scrubber:has(#ts-3:checked) [for="ts-3"] .ts,
  .vg-w-demo-timeline-scrubber:has(#ts-4:checked) [for="ts-4"] .ts,
  .vg-w-demo-timeline-scrubber:has(#ts-5:checked) [for="ts-5"] .ts {
    color: var(--accent-text); font-weight: 600;
  }
  .vg-w-demo-timeline-scrubber:has(#ts-1:checked) [for="ts-1"] .phase,
  .vg-w-demo-timeline-scrubber:has(#ts-2:checked) [for="ts-2"] .phase,
  .vg-w-demo-timeline-scrubber:has(#ts-3:checked) [for="ts-3"] .phase,
  .vg-w-demo-timeline-scrubber:has(#ts-4:checked) [for="ts-4"] .phase,
  .vg-w-demo-timeline-scrubber:has(#ts-5:checked) [for="ts-5"] .phase {
    color: var(--ink);
  }

  /* Keyboard focus —— radio 隱藏但 Tab 仍 focus 得到;outline 借 dot 顯示 */
  .vg-w-demo-timeline-scrubber:has(#ts-1:focus-visible) [for="ts-1"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-2:focus-visible) [for="ts-2"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-3:focus-visible) [for="ts-3"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-4:focus-visible) [for="ts-4"] .dot,
  .vg-w-demo-timeline-scrubber:has(#ts-5:focus-visible) [for="ts-5"] .dot {
    outline: 2px solid var(--accent-text);
    outline-offset: 3px;
  }

  /* Panel:純 CSS 切 display */
  .vg-w-demo-timeline-scrubber .stage {
    display: none;
    padding: var(--s-3) var(--s-4);
    background: var(--bg-soft);
    border: 1px solid var(--line); border-radius: 6px;
    font-family: var(--serif); font-size: var(--fs-sm);
    color: var(--ink-soft); line-height: 1.65;
  }
  .vg-w-demo-timeline-scrubber .stage strong { color: var(--ink); font-weight: 600; }
  .vg-w-demo-timeline-scrubber .stage code {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg); padding: 0.05em 0.32em; border-radius: 3px;
    color: var(--ink);
  }
  .vg-w-demo-timeline-scrubber:has(#ts-1:checked) .s-1,
  .vg-w-demo-timeline-scrubber:has(#ts-2:checked) .s-2,
  .vg-w-demo-timeline-scrubber:has(#ts-3:checked) .s-3,
  .vg-w-demo-timeline-scrubber:has(#ts-4:checked) .s-4,
  .vg-w-demo-timeline-scrubber:has(#ts-5:checked) .s-5 { display: block; }

  /* Caption */
  .vg-w-demo-timeline-scrubber figcaption { margin: 0; display: grid; gap: var(--s-2); }
  .vg-w-demo-timeline-scrubber figcaption .lead {
    font-family: var(--serif); font-style: italic;
    font-size: var(--fs-sm); color: var(--ink-soft);
    line-height: 1.55; margin: 0;
  }
  .vg-w-demo-timeline-scrubber figcaption .lead code {
    font-family: var(--mono); font-style: normal; font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }
  .vg-w-demo-timeline-scrubber figcaption ol {
    margin: 0; padding: 0;
    list-style: none; counter-reset: rule;
    display: grid; gap: 0.3em;
  }
  .vg-w-demo-timeline-scrubber figcaption ol li {
    position: relative;
    padding-left: 2em;
    font-family: var(--serif); font-style: normal;
    font-size: var(--fs-sm); color: var(--ink);
    line-height: 1.5;
  }
  .vg-w-demo-timeline-scrubber figcaption ol li::before {
    counter-increment: rule;
    content: counter(rule) '.';
    position: absolute; left: 0; top: 0;
    font-family: var(--mono); font-variant-numeric: tabular-nums;
    font-size: var(--fs-xs); font-weight: 600;
    color: var(--accent-text); letter-spacing: 0.04em;
  }
  .vg-w-demo-timeline-scrubber figcaption ol li code {
    font-family: var(--mono); font-size: 0.92em;
    background: var(--bg-soft); padding: 0.05em 0.32em; border-radius: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .vg-w-demo-timeline-scrubber .track::after,
    .vg-w-demo-timeline-scrubber .step .dot,
    .vg-w-demo-timeline-scrubber .step .ts,
    .vg-w-demo-timeline-scrubber .step .phase { transition: none; }
  }
</style>

<figure class="vg-w-demo-timeline-scrubber">
  <input type="radio" id="ts-1" name="ts" checked />
  <input type="radio" id="ts-2" name="ts" />
  <input type="radio" id="ts-3" name="ts" />
  <input type="radio" id="ts-4" name="ts" />
  <input type="radio" id="ts-5" name="ts" />

  <div class="track" role="tablist">
    <label class="step" for="ts-1" role="tab">
      <span class="dot"></span>
      <span class="ts">00:00</span>
      <span class="phase">detect</span>
    </label>
    <label class="step" for="ts-2" role="tab">
      <span class="dot"></span>
      <span class="ts">00:05</span>
      <span class="phase">mitigate</span>
    </label>
    <label class="step" for="ts-3" role="tab">
      <span class="dot"></span>
      <span class="ts">00:15</span>
      <span class="phase">root cause</span>
    </label>
    <label class="step" for="ts-4" role="tab">
      <span class="dot"></span>
      <span class="ts">01:00</span>
      <span class="phase">postmortem</span>
    </label>
    <label class="step" for="ts-5" role="tab">
      <span class="dot"></span>
      <span class="ts">04:00</span>
      <span class="phase">runbook</span>
    </label>
  </div>

  <div class="stage s-1" role="tabpanel">
    <strong>00:00 · 偵測。</strong>SLO error rate 飆過 <code>0.2%</code> 門檻,oncall 被 paged。dashboard 顯示 <code>POST /webapi/entry</code> 的 5xx 在 <code>30s</code> 內從 0 衝到 <code>180 req/s</code>。
  </div>
  <div class="stage s-2" role="tabpanel">
    <strong>00:05 · 緩解。</strong>oncall 把 scgi worker pool 重啟、error rate 從 <code>0.18%</code> 回落到 baseline <code>0.001%</code>。但只是把症狀 mask 掉,還沒鎖 root cause。
  </div>
  <div class="stage s-3" role="tabpanel">
    <strong>00:15 · 鎖 root cause。</strong>追到 <code>APIRunner.cpp:983</code> 的 <code>m_runner_reusable</code> 在 scgi 模式下 latch 翻黑後鎖死;新版的 build 觸發了一段 <code>dlopen</code> 路徑,連鎖反應。
  </div>
  <div class="stage s-4" role="tabpanel">
    <strong>01:00 · postmortem 草稿。</strong>timeline + 5 whys 寫好,等 lead review。要強調的關鍵是「symptom 跟 cause 差 15 分鐘」的時間差。
  </div>
  <div class="stage s-5" role="tabpanel">
    <strong>04:00 · 收尾。</strong>action items 進 tracker:`env-guard` 重構、SLO 警報門檻調整、runbook 補上 <code>dlopen</code> handle cache 章節。incident close。
  </div>

  <figcaption>
    <p class="lead">純 CSS scrubber:5 個 <code>&lt;input type="radio"&gt;</code> + <code>:has(:checked)</code> 驅動兩件事:</p>
    <ol>
      <li>切 step 對應的 <code>.stage</code> panel <code>display</code>(舊 panel 收掉、新 panel 出來)。</li>
      <li>track 上 accent 填充線寬度從 0% → 20% → … → 80% 隨選中位置延伸,給出「時間流動」感。</li>
    </ol>
    <p class="lead">鍵盤:Tab 進來、Arrow Left/Right 切 step。零 JS。</p>
  </figcaption>
</figure>
