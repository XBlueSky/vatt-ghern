---
layout: layouts/base.njk
pagination:
  data: collections.weeksWithPosts
  size: 1
  alias: week
permalink: "/weeks/{{ week.weekKey }}/"
eleventyComputed:
  title: "{{ week.weekLabel }} — vatt'ghern"
---
<section class="vg-week-archive">
  <header class="vg-week-archive-hero">
    <h1 class="vg-week-archive-title">
      {{ week.weekLabel }}
      {% if week.weekly %}<span class="vg-week-marker">weekly</span>{% endif %}
    </h1>
  </header>

  {% if week.weekly %}
    <section class="vg-week-archive-weekly">
      <h2 class="vg-week-weekly-title">
        <a href="{{ week.weekly.url }}">{{ week.weekly.data.title }}</a>
      </h2>
      <p class="vg-week-weekly-lede">{{ week.weekly.data.summary }}</p>
      <p class="vg-week-weekly-cta">
        <a href="{{ week.weekly.url }}">read the weekly →</a>
      </p>
    </section>
  {% endif %}

  <section class="vg-week-archive-days">
    <h2 class="vg-week-archive-days-label">這週發過的</h2>
    {% if week.days.length > 0 %}
      {% for day in week.days %}
        <div class="vg-day-row">
          <span class="vg-day-date">{{ day.date | dateMD }}</span>
          <div class="vg-day-posts">
            {% for p in day.posts %}
              <a href="{{ p.url }}">{{ p.data.title }}</a>
              {% if not loop.last %} · {% endif %}
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      <p class="vg-week-archive-empty">這週還沒發任何文。</p>
    {% endif %}
  </section>

  <nav class="vg-week-archive-nav">
    {% set wList = collections.weeksWithPosts %}
    {% set prevWeek = null %}
    {% set nextWeek = null %}
    {% for w in wList %}
      {% if w.weekKey == week.weekKey %}
        {% if not loop.last %}
          {% set prevWeek = wList[loop.index] %}
        {% endif %}
        {% if not loop.first %}
          {% set nextWeek = wList[loop.index0 - 1] %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% if prevWeek %}
      <a class="vg-week-archive-prev" href="/weeks/{{ prevWeek.weekKey }}/">← {{ prevWeek.weekLabel }}</a>
    {% endif %}
    {% if nextWeek %}
      <a class="vg-week-archive-next" href="/weeks/{{ nextWeek.weekKey }}/">{{ nextWeek.weekLabel }} →</a>
    {% endif %}
  </nav>
</section>
