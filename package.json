{
  "name": "vatt-ghern",
  "version": "0.1.0",
  "private": true,
  "description": "Public tech blog — daily news authored by Claude routine",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --quiet",
    "prebuild": "node scripts/build-og.mjs && node scripts/build-card.mjs",
    "build": "eleventy",
    "clean": "rm -rf _site",
    "sigil": "node scripts/build-sigil.mjs",
    "og": "node scripts/build-og.mjs",
    "card": "node scripts/build-card.mjs",
    "social": "node scripts/build-social.mjs",
    "lint:html": "html-validate \"_site/**/*.html\"",
    "test": "node --test tests/*.mjs tests/decisions/*.mjs",
    "sources:list": "node skills/daily-news/scripts/list-sources.mjs",
    "sources:dry-run": "node skills/daily-news/scripts/fetch-all.mjs --dry-run",
    "sources:cluster": "node skills/daily-news/scripts/cluster-candidates.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "@11ty/eleventy-plugin-rss": "^3.0.0",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "@fontsource/eb-garamond": "^5.2.7",
    "@fontsource/im-fell-english": "^5.2.6",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/lxgw-wenkai-tc": "^5.2.9",
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/spectral": "^5.2.8",
    "@playwright/test": "^1.60.0",
    "html-validate": "^9.0.0",
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "lucide-static": "^1.16.0",
    "prismjs": "^1.30.0",
    "satori": "^0.26.0",
    "wawoff2": "^2.0.1"
  }
}
